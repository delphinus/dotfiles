      {
        "id": "9",
        "type": "custom-command",
        "commandPath": "f=\"$HOME/.cache/ccstatusline-smart-confirm/$WEZTERM_PANE\"; [ -n \"$WEZTERM_PANE\" ] && [ -f \"$f\" ] && { t=$(cut -f1 \"$f\"); [ $(($(date +%s)-t)) -lt 60 ] && printf '✓ %s' \"$(cut -f2- \"$f\")\"; }; true",
        "timeout": 500,
        "maxWidth": 60,
        "color": "green"
      }
    ],
    [],
    []
  ],
  "flexMode": "full-minus-40",
  "compactThreshold": 60,
  "colorLevel": 3,
  "inheritSeparatorColors": false,
  "globalBold": false,
  "gitCacheTtlSeconds": 5,
  "minimalistMode": false,
  "powerline": {
