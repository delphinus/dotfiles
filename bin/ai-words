#!/usr/bin/env node
// ai-words - AI が書いた日本語に出やすい語を textlint で指摘する。
//
//   ai-words [FILE...]        ファイルを lint する (- で標準入力、--ext で書式指定)
//   ai-words diff [BASE]      ブランチ差分のうち、足した行だけを lint する
//   ai-words hook             Claude Code のフックとして動く (標準入力にフックの JSON)
//
// textlint 本体と設定は ~/.local/share/claude-textlint に置いてある
// (ansible/tasks/claude_code.yml が ansible/files/claude_textlint から作る)。
// 指摘したくない語は そこの .textlintrc.json の allows に足す。
// 足して指摘したい語は ansible/files/claude_textlint/ai-words.json に書く。

import { spawnSync } from 'node:child_process'
import { createHash } from 'node:crypto'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'

const RUNTIME = path.join(os.homedir(), '.local/share/claude-textlint')
const TEXTLINT = path.join(RUNTIME, 'node_modules/.bin/textlint')
const CONFIG = path.join(RUNTIME, '.textlintrc.json')
const STATE_DIR = path.join(os.tmpdir(), 'claude-ai-words')
const STATE_TTL_MS = 6 * 60 * 60 * 1000
const OVERRIDE_LOG = path.join(os.homedir(), '.local/state/ai-words/overrides.log')

// 拡張子ごとに textlint のプラグインが決まる。md は組み込みの markdown、
// html は textlint-plugin-html、txt は組み込みの text。
const LINTABLE_EXT = new Set(['.md', '.markdown', '.html', '.xhtml', '.txt'])

const usage = `使い方:
  ai-words [--ext EXT] [FILE...]   ファイル (または - で標準入力) を lint する
  ai-words diff [BASE] [--full]    ブランチ差分を lint する
  ai-words hook                    Claude Code のフックとして動く

  --ext EXT   標準入力の書式。md (既定) / html / txt / jira
  --full      diff で、足した行だけでなくファイル全体を見る

BASE を省くと origin/HEAD との merge-base を使う。未コミットの変更も含める。
`

// ---------------------------------------------------------------- lint core

function hasJapanese(s) {
  // ひらがな・カタカナ・漢字・半角カナ
  return /[぀-ヿ㐀-鿿豈-﫿ｦ-ﾟ]/.test(s)
}

// Jira の wiki markup にはコメント構文が無いので、コード記法だけ空白に置き換えてから
// プレーンテキストとして掛ける。行と桁がずれないよう同じ長さの空白で埋める。
function maskJiraMarkup(text) {
  const blank = (m) => m.replace(/[^\n]/g, ' ')
  return text
    .replace(/\{code(?::[^}]*)?\}[\s\S]*?\{code\}/g, blank)
    .replace(/\{noformat\}[\s\S]*?\{noformat\}/g, blank)
    .replace(/\{\{[^}\n]*\}\}/g, blank)
}

function extFor(kind) {
  if (kind === 'html') return '.html'
  if (kind === 'jira' || kind === 'txt' || kind === 'text') return '.txt'
  return '.md'
}

// ------------------------------------------------- ソースコードのコメント

// textlint はコードの構造を解さないので、コメント以外を同じ長さの空白に置き換えてから
// プレーンテキストとして掛ける。行と桁が元のファイルと一致するので、指摘を
// そのままエディタで開ける。
//
// line       行コメントの開始。bol が真なら行頭 (空白を除く) のときだけ認める
// block      [開始, 終了] の組
// strings    [開始, 終了] の組。この中はコメントと見なさない
// noEscape   バックスラッシュによるエスケープを解釈しない文字列の開始記号
const COMMENT_SPECS = [
  {
    exts: ['.ts', '.tsx', '.js', '.jsx', '.mjs', '.cjs', '.go', '.rs', '.java', '.kt',
           '.kts', '.swift', '.scala', '.c', '.h', '.cc', '.cpp', '.hpp', '.cs', '.php',
           '.dart', '.zig', '.jsonc', '.json5'],
    line: [{ mark: '//' }],
    block: [['/*', '*/']],
    strings: [['"', '"'], ["'", "'"], ['`', '`']],
  },
  { exts: ['.css', '.scss', '.less'], line: [], block: [['/*', '*/']], strings: [['"', '"'], ["'", "'"]] },
  {
    exts: ['.py'],
    line: [{ mark: '#' }],
    // docstring は実装上ただの文字列だが、読み手にとっては文書なので対象に含める
    block: [['"""', '"""'], ["'''", "'''"]],
    strings: [['"', '"'], ["'", "'"]],
  },
  {
    exts: ['.rb', '.rake', '.gemspec'],
    line: [{ mark: '#' }],
    block: [['=begin', '=end']],
    strings: [['"', '"'], ["'", "'"]],
  },
  {
    exts: ['.sh', '.bash', '.zsh', '.fish', '.pl', '.pm', '.t', '.yaml', '.yml', '.toml',
           '.tf', '.tfvars', '.conf', '.ini', '.gitconfig', '.dockerfile', '.env'],
    line: [{ mark: '#' }],
    block: [],
    strings: [['"', '"'], ["'", "'"]],
    noEscape: ["'"],
  },
  { exts: ['.lua'], line: [{ mark: '--' }], block: [['--[[', ']]'], ['[[', ']]']], strings: [['"', '"'], ["'", "'"]] },
  // Vim script の " は文字列とも区別が付かないので、行頭のものだけコメントとみなす
  { exts: ['.vim'], line: [{ mark: '"', bol: true }, { mark: '#', bol: true }], block: [], strings: [["'", "'"]] },
  { exts: ['.sql'], line: [{ mark: '--' }], block: [['/*', '*/']], strings: [["'", "'"]] },
]

const COMMENT_EXT = new Map()
for (const spec of COMMENT_SPECS) for (const e of spec.exts) COMMENT_EXT.set(e, spec)

// 拡張子の無い実行スクリプト (~/git/dotfiles/bin にたくさんある) は shebang で見分ける。
const SHEBANG_EXT = [
  [/\b(node|bun|deno)\b/, '.js'],
  [/\bpython[\d.]*\b/, '.py'],
  [/\bruby\b/, '.rb'],
  [/\bperl\b/, '.pl'],
  [/\b(bash|zsh|sh|fish)\b/, '.sh'],
]

function specForFile(file, head) {
  const ext = path.extname(file).toLowerCase()
  if (ext) return COMMENT_EXT.get(ext)
  if (!head?.startsWith('#!')) return undefined
  const line = head.slice(0, head.indexOf('\n') + 1 || head.length)
  for (const [re, e] of SHEBANG_EXT) if (re.test(line)) return COMMENT_EXT.get(e)
  return undefined
}

function maskCode(src, spec) {
  const out = new Array(src.length)
  for (let i = 0; i < src.length; i += 1) out[i] = src[i] === '\n' ? '\n' : ' '
  const keep = (from, to) => {
    for (let i = from; i < to && i < src.length; i += 1) out[i] = src[i]
  }
  const atBol = (i) => {
    for (let j = i - 1; j >= 0; j -= 1) {
      if (src[j] === '\n') return true
      if (src[j] !== ' ' && src[j] !== '\t') return false
    }
    return true
  }

  let i = 0
  outer: while (i < src.length) {
    // ブロックコメント (--[[ を -- より先に見るため block を先に判定する)
    for (const [open, close] of spec.block) {
      if (src.startsWith(open, i)) {
        const end = src.indexOf(close, i + open.length)
        const stop = end < 0 ? src.length : end + close.length
        // Lua の [[ ]] は長い文字列で、コメントではない
        if (!(open === '[[' && spec.exts.includes('.lua'))) keep(i + open.length, end < 0 ? src.length : end)
        i = stop
        continue outer
      }
    }
    // 行コメント
    for (const l of spec.line) {
      if (src.startsWith(l.mark, i) && (!l.bol || atBol(i))) {
        // シェルの # は語頭のときだけ (例: ${#foo} や色指定の #fff を避ける)
        if (l.mark === '#' && !l.bol && i > 0 && !/[\s;|&(]/.test(src[i - 1])) break
        const nl = src.indexOf('\n', i)
        const end = nl < 0 ? src.length : nl
        keep(i + l.mark.length, end)
        i = end
        continue outer
      }
    }
    // 文字列はまたぐ
    let skipped = false
    for (const [open, close] of spec.strings) {
      if (src.startsWith(open, i)) {
        const escapable = !(spec.noEscape || []).includes(open)
        let j = i + open.length
        while (j < src.length) {
          if (escapable && src[j] === '\\') j += 2
          else if (src.startsWith(close, j)) break
          else if (src[j] === '\n' && open !== '`') break // 行をまたぐ文字列は諦める
          else j += 1
        }
        i = j + (src.startsWith(close, j) ? close.length : 0)
        skipped = true
        break
      }
    }
    if (!skipped) i += 1
  }
  return out.join('')
}

// 起動のたびに kuromoji の辞書を読むので、textlint は 1 回にまとめる。
// argv が長くなりすぎないよう、この数ずつ分けて呼ぶ。
const LINT_BATCH = 200

// 複数のファイルを lint し、実パス -> 指摘[] の Map を返す。
function lintFiles(files) {
  const map = new Map()
  if (!files.length) return map
  if (!fs.existsSync(TEXTLINT)) {
    throw new Error(
      `textlint が見つからない: ${TEXTLINT}\n` +
        'ansible (play-ansbile) を流すか、~/.local/share/claude-textlint で npm ci してください。',
    )
  }
  for (let i = 0; i < files.length; i += LINT_BATCH) {
    const batch = files.slice(i, i + LINT_BATCH)
    // --no-textlintrc は -c と併用できない (ルールが 0 件になる)。
    // -c を渡せば対象ファイル側の .textlintrc は探索されない。
    const r = spawnSync(TEXTLINT, ['-c', CONFIG, '-f', 'json', ...batch], {
      encoding: 'utf8',
      maxBuffer: 256 * 1024 * 1024,
    })
    // textlint は指摘があると exit 1。stdout に JSON が出ていれば成功とみなす。
    const out = (r.stdout || '').trim()
    if (!out) {
      const why = (r.stderr || '').trim() || `exit ${r.status}`
      throw new Error(`textlint の実行に失敗した: ${why}`)
    }
    for (const f of JSON.parse(out)) {
      const found = []
      for (const m of f.messages || []) {
        // メッセージは `"語" (別形) は…` の形。先頭の引用符の中だけを取る。
        const w = /^[""「"](.+?)[""」"]/.exec(m.message)
        found.push({ line: m.line, col: m.column, word: w ? w[1] : '', message: m.message })
      }
      map.set(fs.realpathSync(f.filePath), found)
    }
  }
  return map
}

function lintFile(file) {
  return lintFiles([file]).get(fs.realpathSync(file)) || []
}

function lintText(text, kind = 'md') {
  if (!hasJapanese(text)) return []
  const body = kind === 'jira' ? maskJiraMarkup(text) : text
  return lintBuffer(body, extFor(kind))
}

function lintBuffer(body, ext) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ai-words-'))
  const file = path.join(dir, `body${ext}`)
  try {
    fs.writeFileSync(file, body)
    return lintFile(file)
  } finally {
    fs.rmSync(dir, { recursive: true, force: true })
  }
}

// 拡張子を見て、文書はそのまま、ソースコードはコメントだけ取り出して lint する。
// 対象外の拡張子なら null を返す。
function lintPath(file) {
  const ext = path.extname(file).toLowerCase()
  if (LINTABLE_EXT.has(ext)) return lintFile(file)
  const src = fs.readFileSync(file, 'utf8')
  const spec = specForFile(file, src)
  if (!spec) return null
  if (!hasJapanese(src)) return []
  const masked = maskCode(src, spec)
  if (!hasJapanese(masked)) return []
  return lintBuffer(masked, '.txt')
}

// -------------------------------------------------------- 同じ文面の再実行

// 一度指摘した文面をそのまま出し直してきたら「意図した言い回し」とみなして通す。
// これが無いと、言い換えようのない語を含む本文で延々と差し戻すことになる。
function seenBefore(key) {
  const h = createHash('sha256').update(key).digest('hex').slice(0, 32)
  const f = path.join(STATE_DIR, `${h}.txt`)
  try {
    fs.mkdirSync(STATE_DIR, { recursive: true })
    sweepState()
    if (fs.existsSync(f)) return true
    fs.writeFileSync(f, '')
  } catch {
    // 状態を持てなくても lint は続ける (常に指摘する側に倒れる)
  }
  return false
}

function sweepState() {
  const now = Date.now()
  for (const name of fs.readdirSync(STATE_DIR)) {
    const p = path.join(STATE_DIR, name)
    try {
      if (now - fs.statSync(p).mtimeMs > STATE_TTL_MS) fs.rmSync(p, { force: true })
    } catch {
      /* 無視 */
    }
  }
}

// seenBefore() が通す側に倒れたとき、そのままだと何も出さずに終わる。
// 「意図した語なので残した」という判断がどこにも現れないと、ユーザは後から
// 本文に残った語を見ても、直し忘れなのか意図なのか区別できない。Claude が
// 口頭で伝えるかどうかに任せず、通知とログを必ず残す。
function announceOverride(groups) {
  const words = []
  const places = []
  for (const [label, found] of groups) {
    for (const f of found) {
      if (f.word && !words.includes(f.word)) words.push(f.word)
      places.push(`${label || '(不明)'} ${f.line}:${f.col} ${f.word}`)
    }
  }
  const labels = [...new Set(groups.map(([l]) => l).filter(Boolean))]
  const summary = `${labels.join(', ') || '(不明)'}: ${words.join('・')}`

  try {
    fs.mkdirSync(path.dirname(OVERRIDE_LOG), { recursive: true })
    fs.appendFileSync(OVERRIDE_LOG, `${new Date().toISOString()}\t${places.join('\t')}\n`)
  } catch {
    // ログを残せなくても通知は出す
  }
  // 通知はユーザに直接届く唯一の手段だが、失敗しても作業は止めない。
  try {
    spawnSync('claude-code-hooks', ['notify', 'ai-words', `意図した語として通した: ${summary}`], {
      stdio: 'ignore',
      timeout: 5000,
    })
  } catch {
    /* 無視 */
  }
  process.stdout.write(`ai-words: 意図した語として通した: ${summary}\n`)
}

// ------------------------------------------------------------------ 整形

function report(groups, { forHook = false } = {}) {
  const lines = []
  let total = 0
  for (const [label, found] of groups) {
    for (const f of found) {
      const where = label ? `${label} ${f.line}:${f.col}` : `${f.line}:${f.col}`
      lines.push(`  ${where}\t${f.word}`)
      total += 1
    }
  }
  return [
    `textlint (ai-words-ja): ${total} 件`,
    ...lines,
    'AI が書いた日本語に出やすい語です。言い換えを検討してください。',
    ...(forHook ? ['意図した語であれば、内容を変えずにもう一度同じ操作をすれば通ります。'] : []),
  ].join('\n')
}

// ---------------------------------------------------- シェルコマンドの分解

// gh の --body を取り出すためだけの簡易トークナイザ。
// $(...) と `...` と変数は「中身の分からないもの」として印を付けて返す。
function tokenize(cmd) {
  const tokens = []
  let cur = null
  const push = (text, opaque) => {
    if (cur === null) cur = { text: '', opaque: false }
    cur.text += text
    if (opaque) cur.opaque = true
  }
  const flush = () => {
    if (cur !== null) tokens.push(cur)
    cur = null
  }
  let i = 0
  while (i < cmd.length) {
    const c = cmd[i]
    if (c === '\\') {
      push(cmd[i + 1] ?? '', false)
      i += 2
    } else if (c === "'") {
      const end = cmd.indexOf("'", i + 1)
      if (end < 0) return null
      push(cmd.slice(i + 1, end), false)
      i = end + 1
    } else if (c === '"') {
      let j = i + 1
      let buf = ''
      let opaque = false
      while (j < cmd.length && cmd[j] !== '"') {
        if (cmd[j] === '\\') {
          buf += cmd[j + 1] ?? ''
          j += 2
        } else if (cmd[j] === '$' || cmd[j] === '`') {
          opaque = true
          buf += cmd[j]
          j += 1
        } else {
          buf += cmd[j]
          j += 1
        }
      }
      if (j >= cmd.length) return null
      push(buf, opaque)
      i = j + 1
    } else if (c === '$' || c === '`') {
      push(c, true)
      i += 1
    } else if (/\s/.test(c)) {
      flush()
      // 改行やセミコロンなどの区切りは、後段でコマンド単位に割るために残す
      if (c === '\n') tokens.push({ text: '\n', sep: true })
      i += 1
    } else if (c === ';' || c === '|' || c === '&') {
      flush()
      tokens.push({ text: c, sep: true })
      i += 1
    } else {
      push(c, false)
      i += 1
    }
  }
  flush()
  return tokens
}

// 短縮形の -F は gh api では別の意味 (フィールド指定) なので見ない。
const BODY_FLAGS = new Set(['--body', '-b', '--notes'])
const BODY_FILE_FLAGS = new Set(['--body-file', '--notes-file'])

// gh のサブコマンドから本文らしき文字列を集める。
function extractGhBodies(command) {
  if (/<<-?\s*['"]?\w+/.test(command)) return { bodies: [], heredoc: true }
  const tokens = tokenize(command)
  if (!tokens) return { bodies: [], heredoc: false }

  const bodies = []
  let segment = []
  const segments = []
  for (const t of tokens) {
    if (t.sep) {
      if (segment.length) segments.push(segment)
      segment = []
    } else {
      segment.push(t)
    }
  }
  if (segment.length) segments.push(segment)

  for (const seg of segments) {
    if (seg[0]?.text !== 'gh') continue
    for (let i = 1; i < seg.length; i += 1) {
      const t = seg[i]
      const eq = t.text.indexOf('=')
      let flag = t.text
      let inline = null
      if (t.text.startsWith('--') && eq > 0) {
        flag = t.text.slice(0, eq)
        inline = { text: t.text.slice(eq + 1), opaque: t.opaque }
      }
      if (BODY_FLAGS.has(flag)) {
        const v = inline ?? seg[i + 1]
        if (v && !v.opaque && v.text) bodies.push({ label: flag, text: v.text, kind: 'md' })
        if (!inline) i += 1
      } else if (BODY_FILE_FLAGS.has(flag)) {
        const v = inline ?? seg[i + 1]
        if (v && !v.opaque && v.text) {
          try {
            const p = v.text.replace(/^~/, os.homedir())
            const ext = path.extname(p).toLowerCase()
            bodies.push({
              label: path.basename(p),
              text: fs.readFileSync(p, 'utf8'),
              kind: ext === '.html' || ext === '.xhtml' ? 'html' : 'md',
            })
          } catch {
            /* 読めないファイルは飛ばす */
          }
        }
        if (!inline) i += 1
      }
    }
  }
  return { bodies, heredoc: false }
}

// gh pr create --base <branch> があればそれを PR の宛先とみなす。
// 無ければ null を返し、呼び出し側が origin/HEAD から決める。
function ghPrBase(command) {
  const tokens = tokenize(command)
  if (!tokens) return null
  for (let i = 0; i < tokens.length; i += 1) {
    const t = tokens[i].text
    if (t === '--base' || t === '-B') {
      const v = tokens[i + 1]
      if (v && !v.sep && !v.opaque && v.text) return `origin/${v.text}`
    } else if (t.startsWith('--base=') && !tokens[i].opaque) {
      return `origin/${t.slice('--base='.length)}`
    }
  }
  return null
}

// gh の --repo / -R から owner/name を取り出す。
function ghRepoFlag(command) {
  const tokens = tokenize(command)
  if (!tokens) return null
  for (let i = 0; i < tokens.length; i += 1) {
    const t = tokens[i]
    if (t.opaque || t.sep) continue
    let value = null
    if (t.text === '--repo' || t.text === '-R') {
      const v = tokens[i + 1]
      if (v && !v.sep && !v.opaque && v.text) value = v.text
    } else if (t.text.startsWith('--repo=')) {
      value = t.text.slice('--repo='.length)
    }
    if (!value) continue
    // host/owner/name の形も来るので、末尾 2 つだけ見る。
    const parts = value.replace(/\.git$/, '').split('/').filter(Boolean)
    if (parts.length >= 2) return parts.slice(-2).join('/').toLowerCase()
  }
  return null
}

// remote の URL から owner/name を取り出す。git@host:owner/name.git と
// https://host/owner/name(.git) の両方を見る。
function remoteSlugs(root) {
  const out = git(['remote', '-v'], root) || ''
  const slugs = new Set()
  for (const line of out.split('\n')) {
    const url = line.split(/\s+/)[1]
    if (!url) continue
    const path_ = url
      .replace(/\.git$/, '')
      .replace(/^[^@]+@[^:]+:/, '')
      .replace(/^[a-z+]+:\/\/[^/]+\//i, '')
    const parts = path_.split('/').filter(Boolean)
    if (parts.length >= 2) slugs.add(parts.slice(-2).join('/').toLowerCase())
  }
  return slugs
}

// 同じ指摘の集合なら「見せたうえで押し切った」とみなすための鍵。
function digest(groups) {
  return groups
    .map(([label, found]) => `${label}:${found.map((f) => `${f.line}:${f.col}:${f.word}`).join(',')}`)
    .join('|')
}

// ------------------------------------------------- MCP ツールの本文フィールド

// ツール名の末尾 (サーバ名を除いた部分) ごとに、見るフィールドと書式。
const MCP_FIELDS = {
  confluence_create_page: [['title', 'txt'], ['body', 'html']],
  confluence_update_page: [['title', 'txt'], ['body', 'html']],
  confluence_add_comment: [['body', 'html']],
  confluence_update_comment: [['body', 'html']],
  confluence_reply_comment: [['body', 'html']],
  jira_add_comment: [['body', 'jira']],
  jira_update_comment: [['body', 'jira']],
  jira_create_issue: [['summary', 'txt'], ['description', 'jira']],
  jira_update_issue: [['summary', 'txt'], ['description', 'jira']],
}

function mcpTargets(toolName, input) {
  // mcp__<サーバ名>__<ツール名> から末尾のツール名だけを取る
  const short = toolName.split('__').slice(2).join('__')
  const spec = short && MCP_FIELDS[short]
  if (!spec) return []
  const out = []
  for (const [field, kind] of spec) {
    const v = input?.[field]
    if (typeof v === 'string' && v.trim()) out.push({ label: field, text: v, kind })
  }
  return out
}

// ------------------------------------------------------------------ diff

function git(args, cwd) {
  const r = spawnSync('git', args, { encoding: 'utf8', cwd, maxBuffer: 1 << 28 })
  if (r.status !== 0) return null
  return r.stdout
}

// PR の宛先になるブランチとの分岐点。
function defaultBase(root) {
  const head = git(['symbolic-ref', '--short', 'refs/remotes/origin/HEAD'], root)
  const candidates = [head && head.trim(), 'origin/main', 'origin/master', 'main', 'master']
  for (const c of candidates) {
    if (!c) continue
    const mb = git(['merge-base', 'HEAD', c], root)
    if (mb) return { base: mb.trim(), via: c }
  }
  return null
}

// git diff のハンクから、足した行 (= 右側の行番号) を集める。
function addedLines(root, base, file) {
  const out = git(['diff', '-U0', base, '--', file], root)
  if (!out) return null
  const lines = new Set()
  for (const m of out.matchAll(/^@@ -\S+ \+(\d+)(?:,(\d+))? @@/gm)) {
    const start = Number(m[1])
    const count = m[2] === undefined ? 1 : Number(m[2])
    for (let i = 0; i < count; i += 1) lines.add(start + i)
  }
  return lines
}

// 差分を集めて lint する。textlint の起動を 1 回に抑えるため、対象を全部
// 揃えてからまとめて掛ける (ファイルごとに起動すると 40 ファイルで 13 秒かかった)。
// 戻りは { groups: [[rel, abs, 指摘[]]], files, skipped } か、比較できなければ null。
function collectDiff(root, base, { full = false } = {}) {
  const names = git(['diff', '--name-only', '--diff-filter=ACMR', base, '--'], root)
  if (names === null) return null
  // git add 前の新規ファイルも見る。PR に入る前に直したいので。
  const untracked = git(['ls-files', '--others', '--exclude-standard'], root) || ''
  const newFiles = new Set(untracked.split('\n').filter(Boolean))
  const files = [...new Set([...names.split('\n').filter(Boolean), ...newFiles])]

  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'ai-words-diff-'))
  try {
    const targets = []
    let skipped = 0
    for (const rel of files) {
      const abs = path.join(root, rel)
      let src
      try {
        src = fs.readFileSync(abs, 'utf8')
      } catch {
        continue // 消えたファイルやバイナリ
      }
      const ext = path.extname(abs).toLowerCase()
      if (LINTABLE_EXT.has(ext)) {
        targets.push({ rel, abs, target: abs })
        continue
      }
      const spec = specForFile(abs, src)
      if (!spec) {
        skipped += 1
        continue
      }
      if (!hasJapanese(src)) continue
      const masked = maskCode(src, spec)
      if (!hasJapanese(masked)) continue
      const target = path.join(tmp, `${targets.length}.txt`)
      fs.writeFileSync(target, masked)
      targets.push({ rel, abs, target })
    }

    const found = lintFiles(targets.map((t) => t.target))
    const groups = []
    for (const t of targets) {
      let hits = found.get(fs.realpathSync(t.target)) || []
      if (!hits.length) continue
      // 未追跡のファイルは全行が「足した行」
      if (!full && !newFiles.has(t.rel)) {
        const added = addedLines(root, base, t.rel)
        if (added) hits = hits.filter((f) => added.has(f.line))
      }
      if (hits.length) groups.push([t.rel, t.abs, hits])
    }
    return { groups, files, skipped }
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true })
  }
}

// cwd から見た git リポジトリのルートと、比較先を決める。
function resolveRepo(cwd, baseArg, { quiet = false } = {}) {
  const rootOut = git(['rev-parse', '--show-toplevel'], cwd)
  if (!rootOut) return { error: 'git リポジトリの中で実行してください' }
  const root = rootOut.trim()
  if (baseArg) return { root, base: baseArg }
  const d = defaultBase(root)
  if (!d) return { root, error: '比較先が決められない。BASE を明示してください' }
  if (!quiet) {
    process.stderr.write(`ai-words: ${d.via} との分岐点 (${d.base.slice(0, 7)}) と比べます\n`)
  }
  return { root, base: d.base }
}

function runDiff(argv) {
  let full = false
  let baseArg = null
  for (const a of argv) {
    if (a === '--full') full = true
    else if (a === '-h' || a === '--help') {
      process.stdout.write(usage)
      process.exit(0)
    } else baseArg = a
  }

  const { root, base, error } = resolveRepo(process.cwd(), baseArg)
  if (error) {
    process.stderr.write(`ai-words: ${error}\n`)
    process.exit(3)
  }

  const result = collectDiff(root, base, { full })
  if (!result) {
    process.stderr.write(`ai-words: ${base} と比較できませんでした\n`)
    process.exit(3)
  }
  const { groups, files, skipped } = result

  const total = groups.reduce((n, [, , g]) => n + g.length, 0)
  if (!total) {
    process.stdout.write(
      `textlint (ai-words-ja): 指摘なし (${files.length} ファイルの差分, 対象外 ${skipped})\n`,
    )
    process.exit(0)
  }

  // 指摘のある行そのものを添える。PR を出す前に開かずに直せるように。
  const out = []
  for (const [rel, abs, found] of groups) {
    const src = fs.readFileSync(abs, 'utf8').split('\n')
    out.push(rel)
    for (const f of found) {
      const text = (src[f.line - 1] || '').trim()
      out.push(`  ${String(f.line).padStart(5)}:${String(f.col).padEnd(3)} ${f.word}\t${text.slice(0, 100)}`)
    }
  }
  out.push('')
  out.push(`${groups.length} ファイル / ${total} 件${full ? '' : ' (足した行のみ)'}`)
  process.stdout.write(`${out.join('\n')}\n`)
  process.exit(1)
}

// ------------------------------------------------------------------ hook

function hookDeny(reason) {
  process.stdout.write(
    JSON.stringify({
      hookSpecificOutput: {
        hookEventName: 'PreToolUse',
        permissionDecision: 'deny',
        permissionDecisionReason: reason,
      },
    }),
  )
  process.exit(0)
}

function runHook() {
  let raw = ''
  try {
    raw = fs.readFileSync(0, 'utf8')
  } catch {
    process.exit(0)
  }
  let ev
  try {
    ev = JSON.parse(raw)
  } catch {
    process.exit(0)
  }

  const event = ev.hook_event_name
  const tool = ev.tool_name || ''
  const input = ev.tool_input || {}

  // ---- 2. Write / Edit で書いた文書とコード (PostToolUse)
  if (event === 'PostToolUse' && (tool === 'Write' || tool === 'Edit')) {
    const file = input.file_path
    if (!file) process.exit(0)
    const ext = path.extname(file).toLowerCase()
    // 拡張子が無いものは shebang を見るので、ここでは弾かない
    if (ext && !LINTABLE_EXT.has(ext) && !COMMENT_EXT.has(ext)) process.exit(0)
    if (file.includes('/node_modules/') || file.includes('/.git/')) process.exit(0)

    let text
    try {
      text = fs.readFileSync(file, 'utf8')
    } catch {
      process.exit(0)
    }
    if (!hasJapanese(text)) process.exit(0)

    const found = lintPath(file)
    if (!found || !found.length) process.exit(0)
    const groups = [[path.basename(file), found]]
    if (seenBefore(`file:${file}:${text}`)) {
      announceOverride(groups)
      process.exit(0)
    }

    process.stderr.write(`${report(groups, { forHook: true })}\n`)
    process.exit(2)
  }

  // ---- 3. gh 経由で外へ出る本文 (PreToolUse)
  if (event === 'PreToolUse' && tool === 'Bash') {
    const command = input.command || ''
    // --body-file の場合はコマンド文字列に日本語が無いので、ここで日本語を見ない。
    // 本文ごとの判定は lintText がやる。
    if (!/\bgh\b/.test(command)) process.exit(0)
    const groups = []

    // PR の本文
    const { bodies } = extractGhBodies(command)
    for (const b of bodies) {
      const found = lintText(b.text, b.kind)
      if (found.length) groups.push([b.label, found])
    }

    // gh pr create のときは、PR に入るコードと文書も見る
    if (/\bgh\s+pr\s+create\b/.test(command)) {
      const { root, base } = resolveRepo(ev.cwd, ghPrBase(command), { quiet: true })
      // --repo で別のリポジトリへ出す場合、作業ディレクトリはその PR とは
      // 無関係なことがある (別リポジトリのディレクトリから gh を叩いたとき)。
      // そのまま差分を見ると縁もゆかりも無いリポジトリを lint して止めるので、
      // remote が --repo と噛み合わないときは差分チェックだけ飛ばす。本文の
      // チェックは残す。
      const wanted = ghRepoFlag(command)
      const mismatched = root && wanted && !remoteSlugs(root).has(wanted)
      if (mismatched) {
        process.stderr.write(
          `ai-words: --repo (${wanted}) と作業ディレクトリのリポジトリが違うので、差分のチェックは飛ばします\n`,
        )
      } else if (root && base) {
        const result = collectDiff(root, base)
        for (const [rel, , found] of result?.groups || []) groups.push([rel, found])
      }
    }

    if (!groups.length) process.exit(0)
    if (seenBefore(`bash:${command}:${digest(groups)}`)) {
      announceOverride(groups)
      process.exit(0)
    }
    hookDeny(report(groups, { forHook: true }))
  }

  // ---- 4. MCP 経由で外へ出る本文 (PreToolUse)
  if (event === 'PreToolUse' && tool.startsWith('mcp__')) {
    const targets = mcpTargets(tool, input)
    if (!targets.length) process.exit(0)
    const groups = []
    const keyParts = [tool]
    for (const t of targets) {
      keyParts.push(t.label, t.text)
      const found = lintText(t.text, t.kind)
      if (found.length) groups.push([t.label, found])
    }
    if (!groups.length) process.exit(0)
    if (seenBefore(`mcp:${keyParts.join('␀')}`)) {
      announceOverride(groups)
      process.exit(0)
    }
    hookDeny(report(groups, { forHook: true }))
  }

  process.exit(0)
}

// ------------------------------------------------------------------- CLI

function runCli(argv) {
  let kind = 'md'
  const files = []
  for (let i = 0; i < argv.length; i += 1) {
    const a = argv[i]
    if (a === '--ext') {
      kind = argv[i + 1]
      i += 1
    } else if (a === '-h' || a === '--help') {
      process.stdout.write(usage)
      process.exit(0)
    } else {
      files.push(a)
    }
  }
  if (!files.length) files.push('-')

  const groups = []
  for (const f of files) {
    if (f === '-') {
      groups.push(['(stdin)', lintText(fs.readFileSync(0, 'utf8'), kind)])
    } else {
      const found = lintPath(f)
      if (found === null) {
        process.stderr.write(`ai-words: 対象外の拡張子なので飛ばす: ${f}\n`)
      } else {
        groups.push([path.basename(f), found])
      }
    }
  }
  const total = groups.reduce((n, [, g]) => n + g.length, 0)
  if (!total) {
    process.stdout.write('textlint (ai-words-ja): 指摘なし\n')
    process.exit(0)
  }
  process.stdout.write(`${report(groups)}\n`)
  process.exit(1)
}

const [sub, ...rest] = process.argv.slice(2)
try {
  if (sub === 'hook') runHook()
  else if (sub === 'diff') runDiff(rest)
  else runCli(sub === undefined ? [] : [sub, ...rest])
} catch (e) {
  // フックとして動いているときに異常終了しても作業は止めない。
  process.stderr.write(`ai-words: ${e.message}\n`)
  process.exit(sub === 'hook' ? 0 : 3)
}
