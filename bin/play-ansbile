#!/bin/bash -eux
# dotfiles の Ansible プレイブックを実行する。
#
# secrets.yml は 1Password (vault Private, document ansible/vars/secrets.yml) が
# 単一の真実で git 管理外。実行のたびに取得して配置し、終了時 (成功・失敗とも)
# に削除する。op が未サインインなら `op signin` してから再実行する。
#
# 平文はコミットしないが、内容の SHA256 だけは ansible/vars/secrets.yml.sha256
# としてコミットする。これが無いと secrets.yml の変更が git 差分に現れず、
# daily-sync が他の端末に「流し直しが要る」と伝えられない。取得・検証・ハッシュ
# 更新の実体は bin/secrets-lib.sh にあり、bin/edit-secrets と共有している。
#
# 成功したら実行時刻と適用時の dotfiles HEAD を記録する。daily-sync がこれを
# 見て「dotfiles は更新されたのにプレイブックが流されていない」を検出する。
cd ~/git/dotfiles/ansible
# shellcheck source-path=SCRIPTDIR source=secrets-lib.sh
source ~/git/dotfiles/bin/secrets-lib.sh

trap 'rm -f vars/secrets.yml' EXIT
fetch_secrets vars/secrets.yml

# 取得が途中で切れていないか検証してから流す。
validate_secrets vars/secrets.yml

# ハッシュの更新は検証を通った後に行う (切り詰められた内容のハッシュは配らない)。
# プレイブックの成否とは独立に「1Password の中身が変わった」事実を残したいので、
# ansible-playbook より前に置く。適用に失敗した場合はハッシュだけが未コミットの
# 変更として残り、daily-sync が要対応として拾う。
update_secrets_hash vars/secrets.yml

ansible-playbook -c local ~/git/dotfiles/ansible/local_light.yml

mkdir -p ~/.local/state/daily-sync
printf '%s %s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "$(git -C ~/git/dotfiles rev-parse HEAD)" \
    >~/.local/state/daily-sync/last-ansible
