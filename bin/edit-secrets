#!/bin/bash -eu
# ansible/vars/secrets.yml (1Password document) を編集する。
#
# 1Password の GUI は YAML の編集に向かないので、取得 → $EDITOR → 書き戻しを
# 1 コマンドにまとめる。書き戻す前後で番兵キー検証を掛けるので、途中で切れた
# 内容を掴んだまま編集したり、壊した YAML を 1Password に push したりする事故を
# 防げる (生の op document get / op document edit にはこの防御が無い)。
#
# 書き戻したら ansible/vars/secrets.yml.sha256 を更新する。これをコミットする
# ことで、他の端末の daily-sync が「play-ansbile を流し直せ」と気付ける。
# 詳細は bin/secrets-lib.sh のコメント参照。
#
# 平文は $TMPDIR (macOS ではユーザ専用) の一時ファイルにだけ置き、終了時に
# 成否によらず消す。

DOTFILES_DIR="$HOME/git/dotfiles"
# shellcheck source-path=SCRIPTDIR source=secrets-lib.sh
source "$DOTFILES_DIR/bin/secrets-lib.sh"

if (($# > 0)); then
    echo "usage: $(basename "$0")" >&2
    exit 2
fi

tmp="$(mktemp -t secrets)"
trap 'rm -f "$tmp" "$tmp.orig"' EXIT

fetch_secrets "$tmp"
validate_secrets "$tmp"
cp "$tmp" "$tmp.orig"

"${EDITOR:-nvim}" "$tmp"

if cmp -s "$tmp" "$tmp.orig"; then
    echo "変更なし。1Password へは書き戻さない"
    exit 0
fi

# 編集で壊していないか、書き戻す前にもう一度見る。
validate_secrets "$tmp"

put_secrets "$tmp"
echo "1Password に書き戻した"

update_secrets_hash "$tmp"
