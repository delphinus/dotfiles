#!/bin/bash -eu
# ansible/vars/secrets.yml (1Password document) を編集する。
#
# 1Password の GUI は YAML の編集に向かないので、取得 → nvim → 書き戻しを
# 1 コマンドにまとめる。書き戻す前後で番兵キー検証を掛けるので、途中で切れた
# 内容を掴んだまま編集したり、壊した YAML を 1Password に push したりせずに
# 済む (生の op document get / op document edit にはこの防御が無い)。
#
# 書き戻したら ansible/vars/secrets.yml.sha256 を更新する。これをコミットする
# ことで、他の端末の daily-sync が「play-ansbile を流し直せ」と気付ける。
# 詳細は bin/secrets-lib.sh のコメント参照。
#
# 平文は $TMPDIR (macOS ではユーザ専用) の一時ディレクトリにだけ置き、終了時に
# 成否によらず消す。
#
# $EDITOR (minivim) ではなく普段の nvim で開く。minivim は短い文を打つための
# 最小構成で、ハイライトも LSP も無い。ファイル名を secrets.yml にしているのも
# filetype を yaml にして yamlls を使えるようにするため。ただし普段の設定のままだと
# 平文が手元に残るので、次を止める:
#   - undofile が平文を ~/.local/state/nvim/undo に残す (-c 'set noundofile')。
#   - swap ファイルが平文を ~/.local/state/nvim/swap に残しうる (-n)。
#   - shada がヤンクしたレジスタの中身を残す (-i NONE)。

DOTFILES_DIR="$HOME/git/dotfiles"
# shellcheck source-path=SCRIPTDIR source=secrets-lib.sh
source "$DOTFILES_DIR/bin/secrets-lib.sh"

if (($# > 0)); then
    echo "usage: $(basename "$0")" >&2
    exit 2
fi

tmpdir="$(mktemp -d -t secrets)"
trap 'rm -rf "$tmpdir"' EXIT
tmp="$tmpdir/secrets.yml"

fetch_secrets "$tmp"
validate_secrets "$tmp"
cp "$tmp" "$tmp.orig"

nvim -n -i NONE -c 'set noundofile' "$tmp"

if cmp -s "$tmp" "$tmp.orig"; then
    echo "変更なし。1Password へは書き戻さない"
    exit 0
fi

# 編集で壊していないか、書き戻す前にもう一度見る。
validate_secrets "$tmp"

put_secrets "$tmp"
echo "1Password に書き戻した"

update_secrets_hash "$tmp"
commit_secrets_hash
