#!/bin/bash
# Claude Code の SessionStart / CwdChanged / PostToolUse (EnterWorktree と
# ExitWorktree) フック。Claude Code が作業している
# ディレクトリを ~/.cache/kitty-editprompt/cwd-<kitty のウィンドウ id> に書き出す。
#
# kitty の editprompt (~/.config/kitty/editprompt.py) は、起動したときの
# ディレクトリで nvim を開き、送信後も閉じずに使い回す。Claude Code がセッションの
# 途中で別のリポジトリへ移っても nvim の cwd は変わらないので、blink-cmp-git が
# 古いリポジトリの git の情報 (コミット、Issue、PR、メンション) を出し続ける。
# editprompt の nvim (~/.config/nvim-dev/skkeleton/init.lua) はこのファイルを
# 読んで :cd する。
#
# CwdChanged は Bash ツールのコマンドが終わったとき、シェルの pwd が変わって
# いれば発火する。その pwd が許可されたディレクトリ (起動したディレクトリと
# additionalDirectories) の外なら、Claude Code は直後に起動したディレクトリへ
# 戻すが、戻すときは発火しない。~/claude-scratch で起動したセッションでは
# リポジトリへの cd がいつもこれに当たるので、ここに書くのは Claude Code の本当の
# cwd ではなく「最後に cd した先」になる。補完に欲しいのは作業中のリポジトリの
# ほうなので、これで構わない。ただし /tmp のような寄り道まで追うと補完が外れる
# ので、CwdChanged では git リポジトリの中へ移ったときだけ書く。
#
# EnterWorktree / ExitWorktree はセッションの cwd を移すが、CwdChanged は発火
# しない。移った後もコマンドは worktree で始まるので cd も起きず、そのままでは
# 追従できない。PostToolUse の cwd には移った後のディレクトリが入っているので、
# それを書く。
#
# SessionStart と PostToolUse では無条件に書く。SessionStart は、同じウィンドウで
# 前のセッションが残したリポジトリを新しいセッションが引き継がないようにするため。
#
# ファイル名は Claude Code が動いているウィンドウの id で決める。editprompt の
# nvim は送信先として同じ id を知っている。

[[ -n $KITTY_WINDOW_ID ]] || exit 0

# SessionStart と PostToolUse は cwd、CwdChanged は new_cwd に入っている。
IFS=$'\t' read -r event dir < <(jq -r '[.hook_event_name, .new_cwd // .cwd // ""] | @tsv')
[[ -n $dir ]] || exit 0
if [[ $event == CwdChanged ]]; then
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || exit 0
fi

out=~/.cache/kitty-editprompt
mkdir -p "$out"
# 書きかけを読まれないよう、別名で書いてから置き換える。
printf '%s\n' "$dir" >"$out/cwd-$KITTY_WINDOW_ID.tmp" &&
  mv -f "$out/cwd-$KITTY_WINDOW_ID.tmp" "$out/cwd-$KITTY_WINDOW_ID"
