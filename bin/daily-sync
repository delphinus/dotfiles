#!/usr/bin/env bash
# 複数端末のツール・設定のバージョンを毎日揃えるための launchd ジョブ本体。
#
# 方針: 無人でできることは全部やる。無人でできないこと (1Password の対話認証が
# 要る play-ansbile、sudo が要る LaunchDaemon の入れ替え等) は「差分があるとき
# だけ」通知して人間に渡す。勝手には実行しない。
#
#   daily-sync             通常実行 (1 日 1 回まで)
#   daily-sync --force     当日既に実行済みでも走らせる
#   daily-sync --dry-run   変更を伴う操作をスキップして検知だけ行う
#
# ログ:   ~/Library/Logs/daily-sync.log
# 状態:   ~/.local/state/daily-sync/
# 設定:   ~/.config/daily-sync/env      (secrets.yml 経由で Ansible が配置)
# 拡張:   ~/.config/daily-sync/jobs.d/  (別リポジトリのジョブを symlink で置く)
#
# このスクリプト自身が play-ansbile で置き換わる可能性があるため、全体を main()
# に入れて末尾で呼ぶ。bash はスクリプトを逐次読みするので、こうしないと実行中に
# 中身が入れ替わったときに壊れる。

set -uo pipefail

# brew の 1 コマンドあたりの上限。無人ジョブが永久に終わらなくなるのを防ぐ
# 最後の砦であって、通常の失敗検出には使わない。
#
# ネットワーク待ちは brew_run の ConnectTimeout / agent 外しの方で数秒で落ちる
# ので、この値は「正当に長いビルド」を基準に決める。neovim の HEAD ビルドは
# 負荷の高いときに 15 分を超える (実測で 900 秒では足りずビルドを殺していた)。
readonly BREW_TIMEOUT="${DAILY_SYNC_BREW_TIMEOUT:-2400}"

# brew --repo は ruby の起動を伴い 1 回 300ms 程度かかるので使い回す。
BREW_REPO="$(brew --repo 2>/dev/null)" || BREW_REPO=""
readonly BREW_REPO

readonly STATE_DIR="$HOME/.local/state/daily-sync"
readonly LAST_RUN="$STATE_DIR/last-run"
readonly ANSIBLE_STAMP="$STATE_DIR/last-ansible"
# sudo を要求すると分かった cask の記録先だった。今は quarantine の
# reason=sudo に一本化してあり、残っていれば migrate_sudo_casks が取り込む。
readonly OLD_SUDO_CASKS_FILE="$STATE_DIR/sudo-casks"
readonly ENV_FILE="$HOME/.config/daily-sync/env"
readonly JOBS_DIR="$HOME/.config/daily-sync/jobs.d"
# 追加ジョブ 1 本あたりの上限。ソースビルドを伴うものを想定して長めに取る。
readonly JOB_TIMEOUT="${DAILY_SYNC_JOB_TIMEOUT:-3600}"
readonly DOTFILES="$HOME/git/dotfiles"
readonly SKK_JISYO="$HOME/git/github.com/delphinus/skk-jisyo"
# HEAD ビルド中に nvim が消えるのを埋めるための退避先。config.fish が PATH の
# 末尾に足している。消さずに毎日上書きする。
readonly NVIM_FALLBACK="$HOME/.local/opt/neovim-fallback"
readonly VAULT="${DAILY_SYNC_VAULT:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Notes}"
readonly SNAPSHOT_DIR="$VAULT/端末状態"
# play-ansbile を最後に流してから、新着コミットが無くても流し直すまでの日数。
readonly ANSIBLE_MAX_AGE_DAYS=14
# スナップショットがこの日数より古い端末は「休眠」として差分比較から外す。
readonly SNAPSHOT_STALE_DAYS=7
# 更新に失敗した formula を再挑戦するまでの日数。
readonly QUARANTINE_DAYS=7
# sudo が要ると分かった cask を再評価するまでの日数。失敗と違って直る見込みが
# 薄い一方、cask 側の仕様変更で不要になることはあるので、長めに取って期限は
# 付ける (期限無しにすると、不要になった後も永久に手動リストに居座る)。
readonly QUARANTINE_SUDO_DAYS=30

FORCE=0
DRY_RUN=0
# 人間の対応が要る事項と、実行中に起きた失敗。どちらも空なら通知を出さない。
ACTIONS=()
FAILURES=()

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }
section() { printf '\n%s ==== %s ====\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }
action() {
    ACTIONS+=("$1")
    log "ACTION: $1"
}
failure() {
    FAILURES+=("$1")
    log "FAIL: $1"
}

host_name() { scutil --get LocalHostName 2>/dev/null || hostname -s; }

# 端末の起動時刻 (epoch)。kern.boottime は
#   { sec = 1785975703, usec = 98284 } Thu Aug  6 09:21:43 2026
# の形で返るので sec だけ取る。取れなければ何も出力しない。
#
# 先頭に錨を打つのが肝。`.*sec = ` と書くと貪欲マッチが usec の方に届いて
# usec 値を epoch として返す (実測: 98284 = 1970-01-02 になった)。
boot_epoch() {
    sysctl -n kern.boottime 2>/dev/null | sed -nE 's/^\{ sec = ([0-9]+).*/\1/p'
}

# `brew info --json=v2 --installed` は環境によっては 1 回で数分かかる
# (実測 6 分)。HEAD 対象の抽出・更新前後の比較・リンク切れ検出・スナップショット
# と 5 箇所で必要になるので、1 度取ってファイルに置き、以降は読み直す。
BREW_INFO_CACHE=""
cleanup() { [[ -n "$BREW_INFO_CACHE" ]] && rm -f "$BREW_INFO_CACHE"; }
trap cleanup EXIT

refresh_brew_info() {
    [[ -n "$BREW_INFO_CACHE" ]] || BREW_INFO_CACHE="$(mktemp -t daily-sync-brew)"
    brew info --json=v2 --installed >"$BREW_INFO_CACHE" 2>/dev/null
}

brew_info() { cat "$BREW_INFO_CACHE" 2>/dev/null; }

# timeout(1) 越しに実行する。時間切れなら 124 を返す (coreutils の規約)。
# timeout が無い環境ではそのまま実行する。
with_timeout() {
    local secs="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout --kill-after=30 "$secs" "$@"
    else
        "$@"
    fi
}

# brew を無人実行向けの条件で回す。
#
# SSH_AUTH_SOCK を外すのは、到達できない remote を見ている formula があると
# ssh が agent への問い合わせで無応答のまま居座るため (実測: 廃止済み GHE への
# clone が 17 分以上ハング。agent を外すと 8 秒で "Repository not found")。
# launchd 配下には元々 agent が無いので、こうすると手動実行と本番の挙動が揃う。
# tap は全て HTTPS 化済みなので、正当な fetch で agent を要するものは無い。
# HOMEBREW_NO_AUTO_UPDATE は明示的に brew update を済ませた後の upgrade 用。
# 付けないと upgrade のたびに auto-update が走り、実行が長引くほど再度その
# 間隔を超えて再々実行される悪循環になる (実測: 1 回の実行が 40 分を超えた)。
brew_run() {
    with_timeout "$1" env -u SSH_AUTH_SOCK \
        GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=10' \
        HOMEBREW_NO_AUTO_UPDATE=1 \
        HOMEBREW_NO_ENV_HINTS=1 \
        "${@:2}"
}

# 1 ステップの失敗で全体を止めない。失敗は記録して次へ進む。
run_step() {
    local label="$1"
    shift
    section "$label"
    if "$@"; then
        return 0
    fi
    failure "$label に失敗 (詳細はログ参照)"
    return 1
}

# --- 実行ガード ---------------------------------------------------------

already_ran_today() {
    [[ -f "$LAST_RUN" ]] || return 1
    [[ "$(cat "$LAST_RUN" 2>/dev/null)" == "$(date '+%Y-%m-%d')" ]]
}

# --- Homebrew -----------------------------------------------------------

# mycrons tap は head を HTTPS 化済み。古い端末に残る SSH remote を直す。
# launchd 配下では 1Password SSH agent が使えず、SSH のままだと HEAD を
# 取得できないため。
normalize_tap_remotes() {
    local tap_dir url
    for tap_dir in "$BREW_REPO/Library/Taps/delphinus"/homebrew-*; do
        [[ -d "$tap_dir/.git" ]] || continue
        url="$(git -C "$tap_dir" remote get-url origin 2>/dev/null)" || continue
        case "$url" in
            git@github.com:*)
                local https_url="https://github.com/${url#git@github.com:}"
                log "tap remote を HTTPS に変更: $(basename "$tap_dir") ($url -> $https_url)"
                ((DRY_RUN)) || git -C "$tap_dir" remote set-url origin "$https_url"
                ;;
        esac
    done
    return 0
}

# linked keg が HEAD- で始まる formula のみを返す。versioned keg と HEAD keg が
# 両方 Cellar に残っている formula (utf8proc 等) を誤って HEAD へ切り替えない
# ように、brew list --versions の grep ではなく linked keg で判定する。
head_formulae() {
    brew_info |
        jq -r '.formulae[] | select(.linked_keg // "" | startswith("HEAD")) | .full_name'
}

# formula 名とバージョンの一覧。アップグレード前後の差分検出に使う。
formula_versions() {
    brew_info |
        jq -r '.formulae[] | "\(.full_name)\t\(.linked_keg // .installed[0].version // "")"' | sort
}

# formula の定義が HOMEBREW_OP を要求するか。tap のソースを直接見る。
# brew cat でも取れるが 1 回あたり数百 ms かかるので、ローカルの tap を読む。
formula_needs_homebrew_op() {
    local full_name="$1"
    case "$full_name" in
        */*/*) ;;
        *) return 1 ;; # tap 外 (homebrew/core 等) は該当しない
    esac
    local user="${full_name%%/*}"
    local rest="${full_name#*/}"
    local repo="${rest%%/*}"
    local name="${rest#*/}"
    local tap_dir="$BREW_REPO/Library/Taps/$user/homebrew-$repo"
    local rb
    for rb in "$tap_dir/$name.rb" "$tap_dir/Formula/$name.rb"; do
        [[ -f "$rb" ]] && {
            grep -q 'HOMEBREW_OP' "$rb"
            return $?
        }
    done
    return 1
}

# --- 隔離 (quarantine) --------------------------------------------------
#
# 恒久的に壊れている formula を毎日叩き続けると、実行時間を食い潰した上に
# 同じ失敗通知が毎日出て読まれなくなる。一度失敗したものは一定期間スキップし、
# サマリには「隔離中」として出し続けて存在は見えるようにする。
#
# 形式: <formula>\t<失敗日 YYYY-MM-DD>\t<理由>

quarantine_file() { printf '%s\n' "$STATE_DIR/quarantine"; }

quarantined_since() {
    local f="$1" line
    [[ -f "$(quarantine_file)" ]] || return 1
    line="$(grep -F "$(printf '%s\t' "$f")" "$(quarantine_file)" 2>/dev/null | head -1)" || return 1
    [[ -n "$line" ]] || return 1
    printf '%s\n' "$line" | cut -f2
}

quarantine_reason() {
    local f="$1" line
    [[ -f "$(quarantine_file)" ]] || return 1
    line="$(grep -F "$(printf '%s\t' "$f")" "$(quarantine_file)" 2>/dev/null | head -1)" || return 1
    [[ -n "$line" ]] || return 1
    printf '%s\n' "$line" | cut -f3
}

quarantine_add() {
    local f="$1" reason="$2" tmp
    tmp="$(mktemp)"
    [[ -f "$(quarantine_file)" ]] &&
        grep -vF "$(printf '%s\t' "$f")" "$(quarantine_file)" >"$tmp" 2>/dev/null
    printf '%s\t%s\t%s\n' "$f" "$(date '+%Y-%m-%d')" "$reason" >>"$tmp"
    mv "$tmp" "$(quarantine_file)"
}

quarantine_remove() {
    local f="$1" tmp
    [[ -f "$(quarantine_file)" ]] || return 0
    tmp="$(mktemp)"
    grep -vF "$(printf '%s\t' "$f")" "$(quarantine_file)" >"$tmp" 2>/dev/null
    mv "$tmp" "$(quarantine_file)"
}

# 隔離期間内か。期間を過ぎたら再挑戦させる (formula が直っているかもしれない)。
# reason=sudo だけは期間が別 (QUARANTINE_SUDO_DAYS)。
quarantine_active() {
    local f="$1" since epoch age days
    since="$(quarantined_since "$f")" || return 1
    epoch="$(date -j -f '%Y-%m-%d' "$since" +%s 2>/dev/null)" || return 1
    age=$((($(date +%s) - epoch) / 86400))
    days="$QUARANTINE_DAYS"
    [[ "$(quarantine_reason "$f" 2>/dev/null)" == sudo ]] && days="$QUARANTINE_SUDO_DAYS"
    ((age < days))
}

# 「無人では通せないと学習済み」か。失敗として隔離されているものとは扱いが
# 違い、FAIL ではなく「手で実行してください」の通知に回す。
quarantine_sudo() {
    [[ "$(quarantine_reason "$1" 2>/dev/null)" == sudo ]] && quarantine_active "$1"
}

# アップグレードに失敗した formula は linked keg を失ったまま放置されることが
# ある (実測: install が例外で落ち、/opt/homebrew/bin/mydns が消えて DNS 更新
# ジョブが動かなくなった)。Cellar に keg が残っていれば貼り直す。
#
# keg-only は除外する。リンクされていないのが正常な状態なので、含めると毎回
# 全件が「壊れている」ように見える (実測: 新しい端末で 17 件が候補になった)。
# しかも brew link は keg-only を拒否しても exit 0 を返すため、ログには
# 「復旧した」と出て気付けない。実害もあり、versioned な keg-only
# (openssl@4, openssl@1.1, mysql@8.4, mysql-client@8.4) は --force 無しでも
# 実際に張られてしまい、意図して外してある lib と bin を勝手に載せる (実測)。
repair_unlinked() {
    # Cellar のディレクトリは短い名前、brew link に渡すのは full_name。
    local -a broken=()
    local name full keg
    while IFS=$'\t' read -r name full; do
        [[ -n "$name" ]] || continue
        keg="$(ls -1 "$(brew --cellar)/$name" 2>/dev/null | tail -1)" || continue
        [[ -n "$keg" ]] || continue
        log "リンクが外れている: $full → $keg を貼り直す"
        if brew link --overwrite "$full" >/dev/null 2>&1; then
            log "  復旧した"
        else
            broken+=("$full")
        fi
    done < <(brew_info |
        jq -r '.formulae[] | select((.linked_keg // "") == "" and (.installed | length) > 0
                                    and (.keg_only // false) == false)
               | "\(.name)\t\(.full_name)"')

    if ((${#broken[@]} > 0)); then
        failure "リンクを復旧できなかった formula: ${broken[*]} — brew link --overwrite を手で試す"
    fi
    return 0
}

brew_update() {
    ((DRY_RUN)) && {
        log "(dry-run) brew update をスキップ"
        return 0
    }
    brew_run "$BREW_TIMEOUT" brew update
}

brew_upgrade_versioned() {
    ((DRY_RUN)) && {
        log "(dry-run) brew upgrade をスキップ"
        return 0
    }
    # bottle 系はまとめてよい (HEAD の fetch を伴わないので巻き添えが起きにくく、
    # 依存解決も一括の方が正しい)。全体としての上限だけ掛ける。
    #
    # --formula を明示するのは cask を巻き込まないため。引数なしの brew upgrade は
    # cask も対象にするので、sudo を要求する cask が 1 件混ざるだけで全体が
    # 非ゼロで終わり、formula 側が全て成功していても「brew upgrade に失敗」と
    # しか分からなくなる (実測 2026-08-04: docker-desktop で 4 件の formula 更新が
    # 失敗扱いに埋もれた)。cask は brew_upgrade_casks で個別に扱う。
    brew_run "$((BREW_TIMEOUT * 2))" brew upgrade --formula
}

# --fetch-HEAD を付けても HEAD の更新を取りこぼすこと (= 無言で凍結すること) が
# あるので、判定の materials を先に最新化しておく。
#
# GitHub の formula では Homebrew はローカルのクローンではなく GitHub API で
# 最新コミットを判定する (utils/github.rb の GitHub.last_commit)。手順は
# 「ETag から full sha を取る → 7 文字に切り詰める → その短縮 sha が一意か API に
# 問い合わせる」で、最後が 200 以外なら nil を返す。ところが GitHub は短縮 sha を
# fork network 全体のオブジェクトに対して解決するため (neovim は fork 7000 超)、
# 7 文字はしばしば曖昧になり 422 が返る。Homebrew 自身のコメントが「これを API の
# 失敗と区別できない」と認めており、どちらの場合も nil になる。
#
# nil のときのフォールバック先がキャッシュされたクローンのローカル HEAD で、
# そこは前回ビルドした sha のまま止まっている。結果 installed と一致して「最新」に
# なる (実測 2026-08-02: upstream が 8 コミット先なのに未検出。ローカルでは
# 7 文字で一意なのに API は 422 を返していた)。
#
# フォールバック先を先に進めておけば、API 経路が失敗しても正しく検出される。
refresh_head_caches() {
    local f dir branch before after
    for f in "$@"; do
        dir="$(brew --cache --HEAD "$f" 2>/dev/null)" || continue
        [[ -d "$dir/.git" ]] || continue
        branch="$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null)" || continue
        before="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)" || continue

        # 到達できない remote で居座らないよう brew_run と同じ条件で回す。
        if ! with_timeout 120 env -u SSH_AUTH_SOCK GIT_TERMINAL_PROMPT=0 \
            git -C "$dir" fetch --quiet origin 2>/dev/null; then
            log "$f: キャッシュの fetch に失敗。判定は Homebrew に任せる"
            continue
        fi
        # ff できないときは触らない (Homebrew がビルド時に整えるので任せる)。
        git -C "$dir" merge --ff-only --quiet "origin/$branch" 2>/dev/null || true

        after="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)" || continue
        if [[ "$before" != "$after" ]]; then
            log "$f: キャッシュを進めた ($before -> $after)"
        fi
    done
    return 0
}

# brew upgrade は --fetch-HEAD を付けないと HEAD インストールの formula を
# 一切見ない (brew outdated にすら出ない)。ここが端末間ドリフトの主因だった。
#
# 通常の upgrade と分けるのは、HOMEBREW_OP 未設定などで mycrons 側が失敗しても
# bottle 系の upgrade を巻き込ませないため。
brew_upgrade_head() {
    local -a formulae=()
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] && formulae+=("$line")
    done < <(head_formulae)
    if ((${#formulae[@]} == 0)); then
        log "HEAD インストールの formula は無し"
        return 0
    fi
    log "HEAD 対象 ${#formulae[@]} 件: ${formulae[*]}"

    # mycrons の formula の一部は install 時に HOMEBREW_OP (1Password サービス
    # アカウントトークン) を要求する。焼き込み (inreplace) と install 時の
    # op 参照の両方があり、無いまま走らせると必ず失敗する。
    # トークンを要求しない formula (add_timestamp 等) は更新できるので、
    # tap の formula 定義を見て要求するものだけを外す。
    if [[ -z "${HOMEBREW_OP:-}" ]]; then
        local -a filtered=()
        local f skipped=0
        for f in "${formulae[@]}"; do
            if formula_needs_homebrew_op "$f"; then
                ((skipped++))
            else
                filtered+=("$f")
            fi
        done
        if ((skipped > 0)); then
            action "HOMEBREW_OP が未設定のため formula ${skipped} 件をスキップした。${ENV_FILE} を配置するために play-ansbile が必要"
            formulae=("${filtered[@]}")
        fi
    fi

    ((${#formulae[@]} == 0)) && return 0
    ((DRY_RUN)) && {
        log "(dry-run) brew upgrade --fetch-HEAD をスキップ"
        return 0
    }

    # 隔離中のものを外す。
    local -a targets=() held=()
    local f
    for f in "${formulae[@]}"; do
        if quarantine_active "$f"; then
            held+=("$f ($(quarantined_since "$f") から)")
        else
            targets+=("$f")
        fi
    done
    if ((${#held[@]} > 0)); then
        log "隔離中のためスキップ (${#held[@]} 件): ${held[*]}"
    fi
    ((${#targets[@]} == 0)) && {
        log "更新対象なし"
        return 0
    }

    refresh_head_caches "${targets[@]}"

    # まとめて渡すと 1 本の失敗で残りが巻き添えになるので 1 本ずつ実行する。
    # brew の起動コストが formula 数だけかかるが、失敗を名指しできる方が重要。
    local -a failed=() timed_out=()
    local rc
    for f in "${targets[@]}"; do
        brew_run "$BREW_TIMEOUT" brew upgrade --fetch-HEAD "$f"
        rc=$?
        case $rc in
            0) quarantine_remove "$f" ;;
            124 | 137)
                log "$f が ${BREW_TIMEOUT} 秒でタイムアウトした"
                timed_out+=("$f")
                quarantine_add "$f" "timeout"
                ;;
            *)
                failed+=("$f")
                quarantine_add "$f" "exit=$rc"
                ;;
        esac
    done

    if ((${#timed_out[@]} > 0)); then
        failure "HEAD 更新が ${BREW_TIMEOUT} 秒で打ち切られた formula (${#timed_out[@]} 件): ${timed_out[*]} — ビルドが長すぎる / CPU を絞られている (launchd の ProcessType や Low Power Mode) / remote に到達できていない のどれか。DAILY_SYNC_BREW_TIMEOUT で上限を変えられる"
    fi
    if ((${#failed[@]} > 0)); then
        failure "HEAD 更新に失敗した formula (${#failed[@]} 件): ${failed[*]}"
    fi
    if ((${#failed[@]} + ${#timed_out[@]} > 0)); then
        log "上記は ${QUARANTINE_DAYS} 日間スキップする (期間後に自動で再挑戦)"
    fi

    # ここで自分で failure を記録するので、呼び出し側 (run_step) に汎用の
    # 失敗を二重記録させないよう 0 を返す。
    return 0
}

# --- cask ---------------------------------------------------------------
#
# cask には無人では通せないものがある。docker-desktop は更新の前段で
# /Library/PrivilegedHelperTools 配下の特権ヘルパーを消すため sudo を要求し、
# launchd 配下では端末が無いので必ず失敗する (実測 2026-08-04)。
#
#   sudo: a terminal is required to read the password
#
# SUDO_ASKPASS を渡せば Homebrew は sudo に -A を付ける (system_command.rb) が、
# 毎朝パスワードダイアログが出るのは無人ジョブの趣旨に反するので採らない。
# sudoers の NOPASSWD も、cask が任意パスへ sudo rm -rf を投げる以上、実質
# パスワード無しの root になるので採らない。「無人でできないことは通知して
# 人間に渡す」に倒す。
#
# しかも失敗の仕方は端末によって違う。sudo に pam_tid (Touch ID) を入れて
# ある端末では、端末が無くても即エラーにならず認証ダイアログを出したまま待ち
# 続ける (実測 2026-08-10: ある端末で macskk が BREW_TIMEOUT の 2400 秒を
# 使い切って timeout 扱いになった。同じ日に別の端末では 2 秒でエラーになって
# いる)。ハングは出力に何も残さないので、「一度踏んで学習する」だけの設計では
# この端末で永久に取りこぼす。
#
# そこで cask 定義から root が要るかを先に判定し、要ると分かるものは試行せず
# 通知に回す。Homebrew が upgrade を通せなくなるほど確実に sudo を使うのは
# 以下 (Homebrew 4.6 で確認):
#
#   pkg      /usr/sbin/installer          cask/artifact/pkg.rb
#   pkgutil  Pkg#uninstall                cask/pkg.rb
#   kext     kextstat / kextunload        cask/artifact/abstract_uninstall.rb
#   delete   xargs /bin/rm                同上
#
# delete は「消す対象が実在するときだけ sudo」ではない。each_resolved_path は
# glob の結果が空でも yield し、uninstall_delete はそのまま run! するので、
# パスが 1 本も無くても sudo は起動する (実測のログにも引数の無い
# `sudo ... /usr/bin/xargs -0 -- /bin/rm --` が残っている)。しかも run! なので
# 失敗すれば upgrade ごと落ちる。実在判定はせず一律で弾く。
#
# launchctl と rmdir は入れていない。launchctl は sudo で probe するだけで
# must_succeed: false なので、それ自体では upgrade を止めない。rmdir も
# gain_permissions 経由で非 sudo を先に試す。先回りで弾くと通るはずの更新まで
# 止めることになるので、これらはタイムアウトの診断にだけ使う。
#
# 静的判定をすり抜けたもの (アプリの所有権次第で sudo に切り替わる経路が
# cask/artifact/moved.rb などにある) は、従来どおり一度踏んで学習する。学習先は
# quarantine の reason=sudo。試行を続けると毎日 400MB 超をダウンロードしては
# 捨てることになるため。手で上げれば brew outdated から消えるので通知も止まる。
readonly SUDO_REQUIRED_RE='a terminal is required to read the password|sudo: a password is required|sudo: no tty present'
# 出力の途中で固まったとき「sudo 待ちだった」と判断するための目印。
readonly SUDO_MARKER_RE='which may request your password|Uninstalling packages with'

# 旧 sudo-casks からの移行。専用ファイルは廃止して quarantine に畳んだ。
migrate_sudo_casks() {
    local c migrated=0
    [[ -f "$OLD_SUDO_CASKS_FILE" ]] || return 0
    ((DRY_RUN)) && {
        log "(dry-run) 旧 sudo-casks の移行をスキップ"
        return 0
    }
    while IFS= read -r c; do
        [[ -n "$c" ]] || continue
        quarantine_active "cask:$c" || {
            quarantine_add "cask:$c" "sudo"
            migrated=$((migrated + 1))
        }
    done <"$OLD_SUDO_CASKS_FILE"
    rm -f "$OLD_SUDO_CASKS_FILE"
    log "旧 sudo-casks を quarantine (reason=sudo) に移行した (${migrated} 件)"
}

# cask 定義の走査。いずれも brew_info キャッシュを読むだけなので brew の起動は
# 伴わない。artifacts の要素は {"pkg": [...]} や {"uninstall": [{...}]} の形。
cask_has_artifact() {
    brew_info | jq -e --arg t "$1" --arg k "$2" \
        '[ .casks[] | select(.token == $t) | .artifacts[]?
           | select(type == "object") | has($k) ] | any' >/dev/null 2>&1
}

# uninstall / zap に現れるディレクティブ名 (pkgutil, delete, launchctl ...)。
cask_uninstall_directives() {
    brew_info | jq -r --arg t "$1" \
        '.casks[] | select(.token == $t) | .artifacts[]?
         | select(type == "object") | (.uninstall // .zap // empty)
         | .[]? | select(type == "object") | keys[]?' 2>/dev/null
}

cask_has_directive() {
    local t="$1" want="$2" d
    while IFS= read -r d; do
        [[ "$d" == "$want" ]] && return 0
    done < <(cask_uninstall_directives "$t")
    return 1
}

# 無人では通せないと定義から分かる cask か。通せない理由を表示用に出力する。
cask_root_required() {
    local t="$1" d
    cask_has_artifact "$t" pkg && {
        printf 'pkg\n'
        return 0
    }
    for d in pkgutil delete kext; do
        cask_has_directive "$t" "$d" && {
            printf 'uninstall %s\n' "$d"
            return 0
        }
    done
    return 1
}

# sudo に触れうるか。確実ではないので先回りの除外には使わず、タイムアウトの
# 原因が sudo 待ちかを判断するときにだけ使う (launchctl や rmdir を含む)。
cask_touches_sudo() {
    local t="$1" d
    while IFS= read -r d; do
        case "$d" in
            pkgutil | delete | kext | launchctl | rmdir | script | early_script) return 0 ;;
        esac
    done < <(cask_uninstall_directives "$t")
    cask_has_artifact "$t" pkg
}

# 打ち切られた upgrade が sudo 待ちだったか。出力に目印があれば確定。無くても
# インストール段に入った後で止まっていて、かつ定義が sudo に触れるなら sudo と
# 見なす。ダウンロード段 (==> Fetching downloads) で止まっただけのものを
# 巻き込まないよう、==> Upgrading まで進んでいることを条件にする。
cask_timed_out_on_sudo() {
    local t="$1" out="$2"
    grep -qE "$SUDO_MARKER_RE" <<<"$out" && return 0
    grep -q '==> Upgrading' <<<"$out" && cask_touches_sudo "$t"
}

# `brew outdated --cask --verbose` の生の出力。1 行が
#
#   docker-desktop (4.85.0,235549) != 4.86.0,236216
#
# の形で「現在 != 最新」を持つ。cask_version_pair の材料。
CASK_OUTDATED=""

# cask の「現在 → 最新」。
#
# brew_info キャッシュは使えない。main() が refresh_brew_info を呼ぶのは
# brew update より前なので、キャッシュの .version は「更新前に知っていた最新」=
# インストール済みの版そのものになり、両側が同じ版に見える (実測 2026-08-12:
# 実際は 4.85.0 → 4.86.0 なのに "4.85.0,235549 → 4.85.0,235549" と通知した)。
# outdated 判定に使った出力をそのまま材料にすれば、この段差は生じない。
cask_version_pair() {
    local pair
    pair="$(printf '%s\n' "$CASK_OUTDATED" |
        awk -v t="$1" -F' \\(|\\) != ' '$1 == t { print $2 " → " $3; exit }')"
    [[ -n "$pair" ]] && printf ' (%s)' "$pair"
    return 0
}

brew_upgrade_casks() {
    migrate_sudo_casks

    # --quiet ではなく --verbose で取り、token は 1 列目から拾う。版の情報を
    # 捨てないためで、対象の集合はどちらのフラグでも変わらない。
    CASK_OUTDATED="$(brew_run 300 brew outdated --cask --verbose 2>/dev/null)"

    local -a outdated=()
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] && outdated+=("${line%% *}")
    done <<<"$CASK_OUTDATED"

    if ((${#outdated[@]} == 0)); then
        log "更新対象の cask は無し"
        return 0
    fi
    log "cask 対象 ${#outdated[@]} 件: ${outdated[*]}"

    # root が要ると分かるものと隔離中のものを試行対象から外す。
    local -a targets=() needs_sudo=() held=()
    local c why
    for c in "${outdated[@]}"; do
        if why="$(cask_root_required "$c")"; then
            log "$c は root を要する ($why)。試行せず通知に回す"
            needs_sudo+=("$c")
        elif quarantine_sudo "cask:$c"; then
            log "$c は $(quarantined_since "cask:$c") に sudo を要求した。試行せず通知に回す"
            needs_sudo+=("$c")
        elif quarantine_active "cask:$c"; then
            held+=("$c ($(quarantined_since "cask:$c") から)")
        else
            targets+=("$c")
        fi
    done
    ((${#held[@]} > 0)) && log "隔離中のためスキップ (${#held[@]} 件): ${held[*]}"

    # bash 3.2 では set -u 下で空配列の "${a[@]}" が unbound variable になるため、
    # 展開する前に必ず件数で守る (既存の HEAD 系と同じ約束)。
    if ((${#targets[@]} == 0)); then
        log "試行する cask は無し"
    elif ((DRY_RUN)); then
        log "(dry-run) brew upgrade --cask をスキップ: ${targets[*]}"
    else
        # formula の HEAD 系と同じく 1 件ずつ実行する。1 本の失敗で残りを
        # 巻き添えにせず、失敗したものを名指しできるようにするため。
        local -a failed=() timed_out=()
        local out rc
        for c in "${targets[@]}"; do
            out="$(brew_run "$BREW_TIMEOUT" brew upgrade --cask "$c" 2>&1)"
            rc=$?
            printf '%s\n' "$out"
            case $rc in
                0) quarantine_remove "cask:$c" ;;
                124 | 137)
                    # pam_tid が入っていると sudo はエラーを返さずダイアログを
                    # 出したまま待つので、ハングは sudo 待ちのことがある。
                    # timeout のまま置くと 7 日ごとに 40 分溶かし続ける。
                    if cask_timed_out_on_sudo "$c" "$out"; then
                        log "$c は sudo 待ちで固まったと判断した。以降は試行せず通知に回す"
                        quarantine_add "cask:$c" "sudo"
                        needs_sudo+=("$c")
                    else
                        log "$c が ${BREW_TIMEOUT} 秒でタイムアウトした"
                        timed_out+=("$c")
                        quarantine_add "cask:$c" "timeout"
                    fi
                    ;;
                *)
                    if grep -qE "$SUDO_REQUIRED_RE" <<<"$out"; then
                        log "$c は sudo を要求した。以降は試行せず通知に回す"
                        quarantine_add "cask:$c" "sudo"
                        needs_sudo+=("$c")
                    else
                        failed+=("$c")
                        quarantine_add "cask:$c" "exit=$rc"
                    fi
                    ;;
            esac
        done

        if ((${#timed_out[@]} > 0)); then
            failure "cask の更新が ${BREW_TIMEOUT} 秒で打ち切られた (${#timed_out[@]} 件): ${timed_out[*]}"
        fi
        if ((${#failed[@]} > 0)); then
            failure "cask の更新に失敗 (${#failed[@]} 件): ${failed[*]}"
        fi
        if ((${#failed[@]} + ${#timed_out[@]} > 0)); then
            log "上記は ${QUARANTINE_DAYS} 日間スキップする (期間後に自動で再挑戦)"
        fi
    fi

    # 1 件ずつ action にすると要対応の件数が cask の数だけ膨らみ、macOS の通知
    # (先頭 1 件しか載せられない) で 2 件目以降が見えなくなる。1 行に列挙して、
    # そのまま貼れる 1 本のコマンドを添える。
    if ((${#needs_sudo[@]} > 0)); then
        local list=""
        for c in "${needs_sudo[@]}"; do
            list+="${list:+, }$c$(cask_version_pair "$c")"
        done
        action "sudo が要るため更新できなかった cask ${#needs_sudo[@]} 件: ${list}。手で実行してください: brew upgrade --cask ${needs_sudo[*]}"
    fi

    # 失敗は自分で記録するので、run_step に二重記録させない。
    return 0
}

# --- neovim の退避 --------------------------------------------------------
#
# neovim は HEAD を追いかけているので、upstream の master が動いた日は必ず
# ソースビルドが走る (実測: 直近 30 日のうち 30 日でコミットあり)。そして
# Homebrew は install.rb で
#
#   # first we unlink the currently active keg for this formula otherwise it is
#   # possible for the existing build to interfere with the build we are about to
#   # do! Seriously, it happens!
#   kegs.each(&:unlink) if kegs.present?
#
# と、ビルドを始める前に旧 keg を unlink する。つまりビルドに掛かる 5〜15 分の
# 間ずっと /opt/homebrew/bin/nvim が存在しない。MacBook では蓋を開けた直後に
# このジョブが走るので、作業開始と重なって nvim が起動できなくなる。
#
# そこで更新前の keg を PATH の末尾にあるディレクトリへ複製しておく。brew の
# nvim があるときはそちらが勝ち、消えている間だけ複製版が拾われる。nvim は
# $VIMRUNTIME を自分のバイナリからの相対で解決するので、keg を丸ごと複製すれば
# 自己完結して動く。APFS の clonefile を使うので実コストはほぼゼロ (実測
# 0.6 秒、物理ブロックの追加消費なし)。
#
# bottle 系の更新の後、HEAD 系の更新の前に走らせる。この順なら複製元の keg は
# まだ手付かずで、かつ疎通確認は依存が更新された後の状態 (= 複製版が実際に
# 使われる状況) で行える。
snapshot_nvim_fallback() {
    local keg
    keg="$(brew --prefix neovim 2>/dev/null)" || {
        log "neovim 未インストール。スキップ"
        return 0
    }
    keg="$(readlink -f "$keg" 2>/dev/null)" || {
        log "neovim の keg を解決できない。スキップ"
        return 0
    }
    [[ -x "$keg/bin/nvim" ]] || {
        log "$keg/bin/nvim が無い。スキップ"
        return 0
    }
    ((DRY_RUN)) && {
        log "(dry-run) 退避をスキップ"
        return 0
    }

    local tmp="$NVIM_FALLBACK.new"
    mkdir -p "$(dirname "$NVIM_FALLBACK")" || return 1
    rm -rf "$tmp"
    # -c は APFS の clonefile。非対応のファイルシステムでは通常コピーに落とす。
    if ! cp -Rc "$keg" "$tmp" 2>/dev/null && ! cp -R "$keg" "$tmp"; then
        rm -rf "$tmp"
        failure "neovim の退避に失敗した"
        return 0
    fi

    # 依存 dylib の soname が変わっていると複製版も dyld エラーで起動できない
    # (nvim が名前に版番号を含む形で参照しているのは実質 tree-sitter だけで、
    # その minor 更新のとき。実測で 7 か月に 1 回程度)。壊れたものを PATH に
    # 置くと command not found より分かりにくいので、前回の退避を残す。
    if ! "$tmp/bin/nvim" --version >/dev/null 2>&1; then
        rm -rf "$tmp"
        action "neovim の退避版が起動できないため退避を見送った (依存 dylib の soname 変更の可能性)。今回のビルド中は nvim が使えない"
        return 0
    fi

    rm -rf "$NVIM_FALLBACK"
    mv "$tmp" "$NVIM_FALLBACK"
    log "退避した: $NVIM_FALLBACK ($("$NVIM_FALLBACK/bin/nvim" --version | head -1))"
    return 0
}

# --- 追加ジョブ -----------------------------------------------------------
#
# $JOBS_DIR の実行可能ファイルを名前順に走らせる汎用の拡張点。
#
# 置いてある理由は、daily-sync に載せたいが dotfiles には置けない仕事がある
# ため。dotfiles は public にもミラーしているので、特定の環境にしか無いものを
# ここへ直接書くわけにいかない。ジョブの実体は別のリポジトリに持たせ、その
# setup が jobs.d へ symlink を張る (skk-jisyo と同じ「クローンして setup」)。
#
# ディレクトリが無ければ何もしない。関係の無い端末は素通りする。
#
# ジョブ側の規約:
#   - 標準出力・標準エラーはそのままログへ流す。
#   - `ACTION: ` で始まる行は要対応、`FAIL: ` で始まる行は失敗として、
#     daily-sync のサマリと通知に畳み込む。ジョブは daily-sync の内部構造を
#     知らなくてよく、行を吐くだけでよい。
#   - 自前で FAIL: を出したなら 0 で終わってよい。非 0 で終わったのに FAIL:
#     を 1 行も出していないときだけ、こちら側で汎用の失敗を記録する
#     (両方やると同じ事故が 2 件に見える)。
run_extra_jobs() {
    if [[ ! -d "$JOBS_DIR" ]]; then
        log "$JOBS_DIR が無い。スキップ"
        return 0
    fi

    local job name line rc rcfile reported found=0
    for job in "$JOBS_DIR"/*; do
        # symlink の先が消えていることがあるので -x で実体まで見る。
        [[ -f "$job" && -x "$job" ]] || continue
        found=1
        name="$(basename "$job")"
        log "--- $name ---"
        ((DRY_RUN)) && {
            log "(dry-run) スキップ"
            continue
        }

        # パイプで受けると読み側が subshell になり、ACTIONS/FAILURES への追加が
        # 親に残らない。プロセス置換で受ける。終了ステータスは配管を通らないので
        # 一時ファイルで持ち帰る。
        rcfile="$(mktemp -t daily-sync-job)"
        reported=0
        while IFS= read -r line; do
            case "$line" in
                'ACTION: '*)
                    action "${line#ACTION: }"
                    ;;
                'FAIL: '*)
                    failure "${line#FAIL: }"
                    reported=1
                    ;;
                *) log "  $line" ;;
            esac
        done < <(
            with_timeout "$JOB_TIMEOUT" "$job" 2>&1
            printf '%s' "$?" >"$rcfile"
        )
        rc="$(cat "$rcfile" 2>/dev/null)" || rc=""
        rm -f "$rcfile"

        case "${rc:-0}" in
            0) ;;
            124 | 137)
                failure "$name が ${JOB_TIMEOUT} 秒でタイムアウトした"
                ;;
            *)
                ((reported)) || failure "$name が失敗した (exit=$rc)"
                ;;
        esac
    done

    ((found)) || log "実行可能なジョブが無い"
    return 0
}

# --- アップグレード後に人手が要るものの検知 ------------------------------
#
# 当初は各 formula の post_install に寄せる方針だったが、実際に調べると
#   - claude-code-hooks: hooks は Ansible が settings.json に入れており、
#     post_install で setup を走らせると play-ansbile と互いに書き換え合う
#   - buffalo-timemachine: /Library/LaunchDaemons への配置に root が要る
# ため post_install には寄せられない。検知して通知する方式にしている。

# claude-code-hooks が新しい hook を追加したのに dotfiles の
# .claude/settings.json が追随していない場合を検出する。
check_claude_code_hooks() {
    local prefix shipped
    prefix="$(brew --prefix claude-code-hooks 2>/dev/null)" || prefix=""
    shipped="$prefix/share/claude-code-hooks/hooks.json"
    [[ -n "$prefix" && -f "$shipped" ]] || {
        log "claude-code-hooks 未インストール。スキップ"
        return 0
    }
    local settings="$HOME/.claude/settings.json"
    [[ -f "$settings" ]] || {
        log "$settings が無い。スキップ"
        return 0
    }

    local query='to_entries[] | .key as $e | .value[] | .hooks[] | "\($e)\t\(.command)"'
    local missing
    missing="$(comm -23 \
        <(jq -r "$query" "$shipped" | sort) \
        <(jq -r ".hooks | $query" "$settings" | sort))" || return 1

    if [[ -n "$missing" ]]; then
        log "settings.json に無い hook:"
        printf '  %s\n' "$missing"
        action "claude-code-hooks が新しい hook を追加した。dotfiles の .claude/settings.json に反映が必要 (詳細はログ)"
    else
        log "claude-code-hooks の hook はすべて settings.json に存在"
    fi
    return 0
}

# buffalo-timemachine の LaunchDaemon は root 権限で /Library/LaunchDaemons に
# 置く必要があり brew では更新されない。中身がずれたら sudo コマンドを案内する。
check_buffalo_launchdaemon() {
    local prefix shipped
    prefix="$(brew --prefix buffalo-timemachine 2>/dev/null)" || prefix=""
    shipped="$prefix/share/buffalo-timemachine/com.delphinus.buffalo-tm-thin-compact.plist"
    local installed=/Library/LaunchDaemons/com.delphinus.buffalo-tm-thin-compact.plist
    [[ -n "$prefix" && -f "$shipped" ]] || {
        log "buffalo-timemachine 未インストール。スキップ"
        return 0
    }
    if [[ ! -f "$installed" ]]; then
        log "LaunchDaemon 未配置 (意図的に無効化しているなら無視してよい)"
        return 0
    fi
    if cmp -s "$shipped" "$installed"; then
        log "buffalo-timemachine の LaunchDaemon は最新と一致"
    else
        action "buffalo-timemachine の LaunchDaemon が古い。sudo launchctl bootout system/com.delphinus.buffalo-tm-thin-compact && sudo cp '$shipped' /Library/LaunchDaemons/ && sudo launchctl bootstrap system $installed"
    fi
    return 0
}

# launchd のジョブが生きているか。skk-jisyo は自前で 30 分毎に同期し、setup の
# 再実行も bin/ensure-setup がやるので、ここでは死活だけ見る (同期はしない)。
check_launchd_jobs() {
    local uid label
    uid="$(id -u)"
    for label in com.delphinus.skk-sync com.delphinus.yaskkserv2-dict com.delphinus.yaskkserv2-watchdog; do
        if launchctl print "gui/$uid/$label" >/dev/null 2>&1; then
            log "launchd OK: $label"
        else
            action "launchd ジョブ $label がロードされていない"
        fi
    done

    # skk-sync は 30 分間隔。ログが長時間更新されていなければ止まっている。
    #
    # 経過時間の起点はログの mtime と端末の起動時刻の遅い方にする。mtime だけを
    # 見ると電源オフを挟んだ朝は必ず誤検知する。止まっていたのは端末であって
    # ジョブではないのに、前回シャットダウンからの時間がそのまま「更新されて
    # いない時間」に化けるため (実測 2026-08-06: 08-04 の夕方に電源を落として
    # 翌々朝に起動したところ、起動 6 分後の実行が「2369 分更新されていない」と
    # 報告した)。
    #
    # skk-sync の plist は RunAtLoad=false + StartInterval=1800 なので、起動
    # 直後は最大 30 分発火しない。閾値の 120 分はこの猶予を十分含む。
    local skk_log="$HOME/Library/Logs/skk-sync.log"
    if [[ -f "$skk_log" ]]; then
        local mtime boot since origin age
        mtime="$(stat -f %m "$skk_log")"
        boot="$(boot_epoch)"
        since="$mtime"
        origin="ログの最終更新"
        if [[ -n "$boot" ]] && ((boot > mtime)); then
            since="$boot"
            origin="端末の起動"
        fi
        age=$((($(date +%s) - since) / 60))
        if ((age > 120)); then
            action "skk-sync が${origin}から ${age} 分動いていない。$SKK_JISYO/bin/setup の再実行を検討"
        else
            log "skk-sync は正常 (${origin}から ${age} 分)"
        fi
    fi
    return 0
}

# --- dotfiles (play-ansbile は実行しない) --------------------------------
#
# play-ansbile は 1Password の対話認証が要るため launchd 配下では完走できない。
# 新着があるかどうかだけ判定して、実行はユーザに委ねる。

# dotfiles の remote は SSH (git@github.com:delphinus/dotfiles-private) だが、
# launchd 配下からは 1Password SSH agent に届かないことがある (実測:
# "communication with agent failed" → "Permission denied (publickey)")。
# fetch は HTTPS 経由で行う。remote 設定自体は変えないので、ユーザが手で叩く
# push/pull は従来どおり SSH のまま。
#
# 認証は gh のトークンを credential helper 経由で渡す。当初は osxkeychain 任せ
# にしていたが、そこに github.com のエントリは無く (2026-08-01 実測)、private
# リポジトリなので "could not read Username for 'https://github.com'" で必ず
# 落ちていた。
#
# git は credential.helper を複数登録して順に試すので、まず空値でチェーンを
# 切ってから自前の helper だけを積む。helper 先頭の ! は「シェルコマンドとして
# 解釈せよ」という git の記法。git は helper を get/store/erase のいずれかの
# 引数で呼ぶので、get のときだけ応答する。
#
# --user delphinus は必須。github.com には業務アカウントも同居していて active
# account はどれか 1 つなので、明示しないと業務アカウントのトークンで private
# リポジトリを叩きにいく。トークンをコマンドライン引数に置かない (ps から
# 見えてしまう) ため、http.extraHeader ではなく helper 方式にしている。
readonly GH_CREDENTIAL_HELPER='!f() {
    [ "$1" = get ] || exit 0
    printf "username=x-access-token\npassword=%s\n" \
        "$(gh auth token --hostname github.com --user delphinus)"
}; f'

fetch_dotfiles() {
    local url branch
    url="$(git -C "$DOTFILES" remote get-url origin 2>/dev/null)" || return 1
    branch="$(git -C "$DOTFILES" rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 1
    case "$url" in
        git@github.com:*) url="https://github.com/${url#git@github.com:}" ;;
    esac

    if ! command -v gh >/dev/null 2>&1; then
        failure "gh が見つからないため dotfiles を fetch できない"
        return 1
    fi
    if ! gh auth token --hostname github.com --user delphinus >/dev/null 2>&1; then
        failure "gh が delphinus でログインしていないため dotfiles を fetch できない。gh auth login --hostname github.com が必要"
        return 1
    fi

    # 追跡ref を直接更新するので、この後の @{upstream} 比較はそのまま使える。
    local err
    if ! err="$(env -u SSH_AUTH_SOCK GIT_TERMINAL_PROMPT=0 \
        git -C "$DOTFILES" \
        -c "credential.helper=" \
        -c "credential.helper=$GH_CREDENTIAL_HELPER" \
        fetch --prune --quiet "$url" \
        "+refs/heads/$branch:refs/remotes/origin/$branch" 2>&1)"; then
        [[ -n "$err" ]] && log "$err"
        failure "dotfiles の fetch に失敗した (詳細はログ参照)"
        return 1
    fi
    return 0
}

# play-ansbile を流し直す必要がある変更かどうかを判定するためのパターン。
#
# プレイブックが repo の「ファイルの中身」を読むのは以下だけ:
#   - ansible/ 配下 (プレイブック本体・templates・vars・copy: の src)
#   - template が lookup('file', dotfiles_dir + '...') で読むファイル
# それ以外は state=link で配置されるので編集した瞬間に反映済みだし、bin/ に
# 至っては repo のパスが直接 PATH と LaunchAgent から使われている。つまり
# 変わっても流し直す必要が無い。
#
# 列挙漏れは構造的に起きない。プレイブックが新しく repo のファイルを読むには
# 必ず ansible/ 配下の編集が要り、その編集自体が ^ansible/ に当たるため。
# 唯一の隙間は「lookup を追加したコミットの後で、参照先だけを変えるコミット」
# なので、lookup のパスはハードコードせず毎回 templates から抽出する。
ansible_relevant_patterns() {
    printf '^ansible/\n'
    grep -rhoE "dotfiles_dir *\+ *'/[^']+'" "$DOTFILES/ansible/templates/" 2>/dev/null |
        sed -e "s/.*'\/\(.*\)'/\1/" -e 's/[].[^$*\\]/\\&/g' -e 's/^/^/' -e 's/$/$/'
}

# 標準入力のパス一覧のうち、play-ansbile に関係するものだけを出力する。
filter_ansible_relevant() {
    grep -E -f <(ansible_relevant_patterns) 2>/dev/null || true
}

# 標準入力のパス一覧を ACTION の文言用に 1 行へ畳む。Slack には ACTION しか
# 出ないので原因をここに載せるが、長すぎると読まれないので 3 件で打ち切る。
summarize_paths() {
    local -a paths=()
    local p out n
    while IFS= read -r p; do
        [[ -n "$p" ]] && paths+=("$p")
    done
    n=${#paths[@]}
    ((n == 0)) && return 0
    out="$(printf '%s, ' "${paths[@]:0:3}")"
    out="${out%, }"
    ((n > 3)) && out="$out 他 $((n - 3)) 件"
    printf '%s' "$out"
}

check_dotfiles() {
    local head_sha stamped_sha stamp_date fetched=1
    # 未反映と判断した理由。件数が要対応かどうかの判定を兼ねる。
    local -a reasons=()

    if ((DRY_RUN)); then
        log "(dry-run) git fetch をスキップ"
    elif ! fetch_dotfiles; then
        # 具体的な失敗理由は fetch_dotfiles 側が積んでいる。追跡 ref が古い
        # ままなので新着判定だけ飛ばし、ローカル側の確認は続ける。
        log "fetch できなかったので新着判定はスキップする"
        fetched=0
    fi

    local upstream
    upstream="$(git -C "$DOTFILES" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" || upstream=""
    if ((fetched)) && [[ -n "$upstream" ]]; then
        local behind ahead
        behind="$(git -C "$DOTFILES" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
        ahead="$(git -C "$DOTFILES" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
        if ((behind > 0)); then
            log "$upstream に新着 ${behind} 件。pull する"
            if ((DRY_RUN)); then
                log "(dry-run) pull をスキップ"
            elif git -C "$DOTFILES" merge --ff-only --quiet "$upstream"; then
                reasons+=("新着 ${behind} 件を pull した")
            else
                action "dotfiles が fast-forward できない (ローカルで分岐している)。手動で解消が必要"
            fi
        fi
        ((ahead > 0)) && log "ローカルが $upstream より ${ahead} 件先行 (push 待ち)"
    fi

    local dirty relevant
    dirty="$(git -C "$DOTFILES" status --porcelain 2>/dev/null | awk '{print $NF}')"
    if [[ -n "$dirty" ]]; then
        relevant="$(printf '%s\n' "$dirty" | filter_ansible_relevant)"
        if [[ -n "$relevant" ]]; then
            log "作業ツリーに未コミットの変更あり (play-ansbile に関係するもの: $(printf '%s' "$relevant" | tr '\n' ' '))"
            reasons+=("未コミット: $(printf '%s\n' "$relevant" | summarize_paths)")
        else
            log "作業ツリーに未コミットの変更あり (いずれも play-ansbile に関係しない)"
        fi
    fi

    head_sha="$(git -C "$DOTFILES" rev-parse HEAD 2>/dev/null || echo unknown)"
    if [[ -f "$ANSIBLE_STAMP" ]]; then
        stamp_date=""
        stamped_sha=""
        read -r stamp_date stamped_sha <"$ANSIBLE_STAMP" || true
        if [[ "$head_sha" != "$stamped_sha" ]]; then
            local changed
            if ! git -C "$DOTFILES" cat-file -e "${stamped_sha}^{commit}" 2>/dev/null; then
                # rebase / force-push / クローンし直しで記録した commit が
                # 手元に無い。差分を取れないので従来どおり要対応にする。
                log "play-ansbile 実行時の commit (${stamped_sha:0:12}) が手元に無い。差分を判定できない"
                reasons+=("実行時の commit ${stamped_sha:0:12} が手元に無く差分を判定できない")
            else
                changed="$(git -C "$DOTFILES" diff --name-only "$stamped_sha..HEAD" 2>/dev/null | filter_ansible_relevant)"
                if [[ -n "$changed" ]]; then
                    log "play-ansbile 実行時 (${stamped_sha:0:12}) 以降に関係する変更あり: $(printf '%s' "$changed" | tr '\n' ' ')"
                    reasons+=("$(printf '%s\n' "$changed" | summarize_paths)")
                else
                    log "play-ansbile 実行時 (${stamped_sha:0:12}) から進んでいるが、関係する変更は無い"
                fi
            fi
        fi
        local stamp_epoch age_days
        stamp_epoch="$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "$stamp_date" +%s 2>/dev/null || echo 0)"
        if ((stamp_epoch > 0)); then
            age_days=$((($(date +%s) - stamp_epoch) / 86400))
            log "play-ansbile の最終実行: $stamp_date (${age_days} 日前)"
            if ((age_days > ANSIBLE_MAX_AGE_DAYS)); then
                reasons+=("最終実行から ${age_days} 日経過 (上限 ${ANSIBLE_MAX_AGE_DAYS} 日)")
            fi
        fi
    else
        log "play-ansbile の実行記録が無い"
        reasons+=("実行記録が無い")
    fi

    if ((${#reasons[@]} > 0)); then
        local why
        why="$(printf '%s / ' "${reasons[@]}")"
        action "dotfiles が未反映 (${why% / })。実行してください: $DOTFILES/bin/play-ansbile"
    fi
    return 0
}

# --- 端末間スナップショットと差分 ----------------------------------------
#
# iCloud で同期される Obsidian vault に、端末ごとに 1 ファイルだけ書く。
# ファイルを共有しないので iCloud の競合解決が走る余地が無い。

write_snapshot() {
    mkdir -p "$SNAPSHOT_DIR" || return 1
    local host out
    host="$(host_name)"
    out="$SNAPSHOT_DIR/${host}.json"

    local dotfiles_head dotfiles_dirty skk_head last_ansible self_sha
    dotfiles_head="$(git -C "$DOTFILES" rev-parse HEAD 2>/dev/null || echo unknown)"
    [[ -n "$(git -C "$DOTFILES" status --porcelain 2>/dev/null)" ]] && dotfiles_dirty=true || dotfiles_dirty=false
    skk_head="$(git -C "$SKK_JISYO" rev-parse HEAD 2>/dev/null || echo unknown)"
    last_ansible="$(cut -d' ' -f1 "$ANSIBLE_STAMP" 2>/dev/null || echo null)"
    self_sha="$(shasum -a 256 "${BASH_SOURCE[0]}" 2>/dev/null | cut -c1-12 || echo unknown)"

    ((DRY_RUN)) && {
        log "(dry-run) スナップショットの書き出しをスキップ"
        return 0
    }

    brew_info | jq \
        --arg host "$host" \
        --arg at "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
        --arg macos "$(sw_vers -productVersion)" \
        --arg dotfiles_head "$dotfiles_head" \
        --argjson dotfiles_dirty "$dotfiles_dirty" \
        --arg skk_head "$skk_head" \
        --arg last_ansible "$last_ansible" \
        --arg self_sha "$self_sha" \
        '{
            hostname: $host,
            generated_at: $at,
            macos: $macos,
            daily_sync_sha: $self_sha,
            dotfiles: { head: $dotfiles_head, dirty: $dotfiles_dirty, last_ansible: $last_ansible },
            skk_jisyo_head: $skk_head,
            formulae: ([.formulae[] | { key: .full_name, value: (.linked_keg // .installed[0].version // "") }] | from_entries),
            casks: ([.casks[] | { key: .token, value: ((.installed // "") | tostring) }] | from_entries)
        }' >"$out" || return 1

    log "スナップショットを書き出した: $out"
    return 0
}

# 全端末のスナップショットを突き合わせ、自端末と食い違う項目を列挙する。
# HEAD-<sha> は大小比較ができないので「どちらが新しい」ではなく「不一致」と
# して報告する。両端末で daily-sync が回っていれば一致するのが正常。
compare_snapshots() {
    [[ -d "$SNAPSHOT_DIR" ]] || {
        log "スナップショットが無い"
        return 0
    }
    local host report
    host="$(host_name)"
    report="$SNAPSHOT_DIR/差分レポート.md"

    local -a others=()
    local f
    for f in "$SNAPSHOT_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        [[ "$(basename "$f" .json)" == "$host" ]] && continue
        others+=("$f")
    done

    if ((${#others[@]} == 0)); then
        log "比較対象の他端末が無い (この端末が最初の 1 台)"
        return 0
    fi

    ((DRY_RUN)) && {
        log "(dry-run) 差分レポートの生成をスキップ"
        return 0
    }

    # 全端末の JSON を jq に slurp して 1 本のクエリで処理する。
    # $mine が自端末、$active が比較対象、$dormant が休眠端末。
    local jq_prelude='
        ($now | tonumber) as $now
        | (($stale_days | tonumber) * 86400) as $stale
        | (map(select(.hostname == $me)) | .[0]) as $mine
        | (map(select(.hostname != $me))
           | map(. + { age: ($now - (.generated_at | strptime("%Y-%m-%dT%H:%M:%S%z") | mktime)) })) as $rest
        | ([$rest[] | select(.age <  $stale)]) as $active
        | ([$rest[] | select(.age >= $stale)]) as $dormant
        | ($active | map(. as $o
            | $mine.formulae | to_entries
            | map(select($o.formulae[.key] != null and $o.formulae[.key] != .value))) | add // []) as $all_diffs'

    local body count
    body="$(jq -s -r \
        --arg me "$host" \
        --arg stale_days "$SNAPSHOT_STALE_DAYS" \
        --arg now "$(date +%s)" \
        "$jq_prelude"'
         | [ "# 端末バージョン差分レポート", "",
             "- 生成: \($mine.generated_at) (\($mine.hostname))",
             "- 比較対象: \($active | length) 台 (休眠 \($dormant | length) 台)", "",
             "> このファイルは daily-sync が自動生成する。手で編集しても次回上書きされる。", "" ]
           + ([ $active[] as $o
                | ($mine.formulae | to_entries | map(select($o.formulae[.key] != null and $o.formulae[.key] != .value))) as $diff
                | ($o.formulae | to_entries | map(select($mine.formulae[.key] == null))) as $only_other
                | ($mine.formulae | to_entries | map(select($o.formulae[.key] == null))) as $only_me
                | [ "## vs \($o.hostname)", "", "- スナップショット: \($o.generated_at)", "" ]
                  + (if ($diff | length) > 0
                     then [ "### バージョン不一致", "", "| formula | \($mine.hostname) | \($o.hostname) |", "|---|---|---|" ]
                          + ($diff | map("| \(.key) | \(.value) | \($o.formulae[.key]) |")) + [""]
                     else [] end)
                  + (if ($only_other | length) > 0
                     then [ "### この端末に無い formula", "" ] + ($only_other | map("- \(.key) (\(.value))")) + [""]
                     else [] end)
                  + (if ($only_me | length) > 0
                     then [ "### \($o.hostname) に無い formula", "" ] + ($only_me | map("- \(.key) (\(.value))")) + [""]
                     else [] end)
                  + (if $mine.dotfiles.head != $o.dotfiles.head
                     then [ "### dotfiles", "", "- \($mine.hostname): \($mine.dotfiles.head[0:12])", "- \($o.hostname): \($o.dotfiles.head[0:12])", "" ]
                     else [] end)
              ] | add // [])
           + (if ($dormant | length) > 0
              then [ "## 休眠端末 (\($stale_days) 日以上スナップショットが更新されていない)", "" ]
                   + ($dormant | map("- \(.hostname) (最終: \(.generated_at))")) + [""]
              else [] end)
           | join("\n")' \
        "$SNAPSHOT_DIR"/*.json)" || return 1

    printf '%s\n' "$body" >"$report" || return 1
    log "差分レポートを更新した: $report"

    count="$(jq -s -r \
        --arg me "$host" \
        --arg stale_days "$SNAPSHOT_STALE_DAYS" \
        --arg now "$(date +%s)" \
        "$jq_prelude"' | $all_diffs | length' \
        "$SNAPSHOT_DIR"/*.json)" || count=0
    if ((count > 0)); then
        action "他端末とバージョンが食い違う formula が ${count} 件ある。$report を確認"
    else
        log "他端末とのバージョン不一致は無し"
    fi
    return 0
}

# --- 通知 ---------------------------------------------------------------
#
# 毎日「異常なし」が飛ぶと読まなくなるので、要対応か失敗があるときだけ出す。

notify() {
    ((${#ACTIONS[@]} + ${#FAILURES[@]} == 0)) && {
        log "要対応なし。通知は出さない"
        return 0
    }

    local title="daily-sync"
    local message=""
    ((${#FAILURES[@]} > 0)) && message+="失敗 ${#FAILURES[@]} 件: ${FAILURES[0]}"$'\n'
    ((${#ACTIONS[@]} > 0)) && message+="要対応 ${#ACTIONS[@]} 件: ${ACTIONS[0]}"

    # terminal-notifier があればそれを使う。クリックで Console を開けるのは
    # こちらだけなので優先する。
    #
    # 無い端末のために osascript へ落とす。terminal-notifier は formula 一覧の
    # 全部入り (tasks/homebrew.yml) にしか入っておらず、play-ansbile が流す
    # local_light.yml では入らないので、業務用 Mac には無い (実測)。通知のためだけに
    # 全端末へ formula を 1 本増やしたくないが、通知が消えるのも困る、という
    # 折衷。osascript は macOS 標準なので依存が増えない。
    #
    # 本文は -e に埋め込まず argv で渡す。ACTION の文言には formula 名やパスが
    # そのまま入るため、引用符やバックスラッシュが AppleScript の構文を壊す。
    if command -v terminal-notifier >/dev/null 2>&1; then
        terminal-notifier -title "$title" -message "$message" \
            -execute "open -a Console $HOME/Library/Logs/daily-sync.log" >/dev/null 2>&1 || true
    else
        osascript \
            -e 'on run argv' \
            -e 'display notification (item 1 of argv) with title (item 2 of argv)' \
            -e 'end run' \
            -- "$message" "$title" >/dev/null 2>&1 || true
    fi

    notify_slack
    return 0
}

# Slack へは macOS 通知と同じ条件で送るが、内容は全件入れる。通知センターは
# 長文を切るので先頭 1 件に絞っているのに対し、Slack は複数端末の状況を並べて
# 後から追える台帳になるため、絞る理由が無い。
#
# 隔離中の formula は「送ると決まったとき」だけ添える。これ自体を送信条件に
# すると、1 本壊れている間ずっと毎日届いて読まれなくなる。
notify_slack() {
    local url="${DAILY_SYNC_SLACK_WEBHOOK:-}"
    if [[ -z "$url" ]]; then
        log "DAILY_SYNC_SLACK_WEBHOOK が未設定。Slack 通知はスキップ"
        return 0
    fi
    ((DRY_RUN)) && {
        log "(dry-run) Slack 通知をスキップ"
        return 0
    }

    local text="" color="#daa038" # 要対応のみなら橙、失敗があれば赤
    local item
    if ((${#FAILURES[@]} > 0)); then
        color="#d63333"
        text+="*失敗 ${#FAILURES[@]} 件*"$'\n'
        for item in "${FAILURES[@]}"; do text+="• ${item}"$'\n'; done
    fi
    if ((${#ACTIONS[@]} > 0)); then
        text+="*要対応 ${#ACTIONS[@]} 件*"$'\n'
        for item in "${ACTIONS[@]}"; do text+="• ${item}"$'\n'; done
    fi
    if [[ -s "$(quarantine_file)" ]]; then
        text+="*隔離中 (${QUARANTINE_DAYS} 日後、sudo は ${QUARANTINE_SUDO_DAYS} 日後に自動再挑戦)*"$'\n'
        while IFS=$'\t' read -r name since reason; do
            text+="• ${name} (${since} 以降, ${reason})"$'\n'
        done <"$(quarantine_file)"
    fi

    local payload
    payload="$(jq -n \
        --arg color "$color" \
        --arg text "$text" \
        --arg host "$(host_name)" \
        --arg time "$(date '+%Y-%m-%d %H:%M:%S')" \
        '{attachments: [{
            color: $color,
            title: ":arrows_counterclockwise: daily-sync",
            text: $text,
            mrkdwn_in: ["text"],
            fields: [
                {title: "Host", value: $host, short: true},
                {title: "Time", value: $time, short: true}
            ]
        }]}')" || {
        log "Slack ペイロードの生成に失敗"
        return 0
    }

    # 通知の失敗で daily-sync 自体を失敗扱いにはしない (ログには残す)。
    local rc
    with_timeout 30 curl -sS -X POST -H 'Content-Type: application/json' \
        --data "$payload" "$url" -o /dev/null
    rc=$?
    if ((rc == 0)); then
        log "Slack に通知した"
    else
        log "WARN: Slack への通知に失敗 (curl rc=$rc)"
    fi
    return 0
}

print_summary() {
    section "サマリ"
    if [[ -s "$(quarantine_file)" ]]; then
        log "隔離中 ($(wc -l <"$(quarantine_file)" | tr -d ' ') 件、${QUARANTINE_DAYS} 日後、sudo は ${QUARANTINE_SUDO_DAYS} 日後に自動再挑戦。cask: 付きは cask):"
        while IFS=$'\t' read -r name since reason; do
            log "  - $name ($since 以降, $reason)"
        done <"$(quarantine_file)"
    fi
    if ((${#ACTIONS[@]} > 0)); then
        log "要対応 ${#ACTIONS[@]} 件:"
        printf '  - %s\n' "${ACTIONS[@]}"
    fi
    if ((${#FAILURES[@]} > 0)); then
        log "失敗 ${#FAILURES[@]} 件:"
        printf '  - %s\n' "${FAILURES[@]}"
    fi
    ((${#ACTIONS[@]} + ${#FAILURES[@]} == 0)) && log "すべて正常"
    return 0
}

# --- main ---------------------------------------------------------------

main() {
    while (($#)); do
        case "$1" in
            --force) FORCE=1 ;;
            --dry-run) DRY_RUN=1 ;;
            -h | --help)
                sed -n '2,20p' "${BASH_SOURCE[0]}"
                return 0
                ;;
            *)
                printf 'unknown option: %s\n' "$1" >&2
                return 2
                ;;
        esac
        shift
    done

    mkdir -p "$STATE_DIR"

    if already_ran_today && ! ((FORCE)); then
        log "本日は実行済み。--force で強制実行できる"
        return 0
    fi

    section "daily-sync 開始 ($(host_name))"

    # HOMEBREW_OP など。Ansible が secrets.yml 経由で配置する。
    if [[ -f "$ENV_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        log "$ENV_FILE を読み込んだ"
    else
        log "$ENV_FILE が無い (mycrons の更新はスキップされる)"
    fi

    local before after
    refresh_brew_info
    before="$(formula_versions)"

    run_step "tap remote の正規化" normalize_tap_remotes
    run_step "brew update" brew_update
    run_step "brew upgrade (bottle 系)" brew_upgrade_versioned
    run_step "neovim の退避" snapshot_nvim_fallback
    run_step "brew upgrade --fetch-HEAD (HEAD 系)" brew_upgrade_head
    # formula を全て片付けてから cask に入る。cask は巨大なダウンロードを伴う
    # ことがあり、先に置くと neovim の退避が無用に遅れる。
    run_step "brew upgrade (cask)" brew_upgrade_casks

    # ここから先は upgrade 後の状態を見る。リンク切れの検出も比較もこの
    # キャッシュを使うので、復旧より前に取り直す。
    refresh_brew_info
    run_step "リンクが外れた formula の復旧" repair_unlinked

    section "更新された formula"
    after="$(formula_versions)"
    local changed
    changed="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after"))"
    if [[ -n "$changed" ]]; then
        printf '%s\n' "$changed" | while IFS=$'\t' read -r name ver; do
            log "  $name -> $ver"
        done
    else
        log "  変更なし"
    fi

    # brew を片付けてから。ジョブにはソースビルドを伴うものがあり、先に置くと
    # formula の更新がその分遅れる。
    run_step "追加ジョブ" run_extra_jobs

    run_step "claude-code-hooks の hook 差分確認" check_claude_code_hooks
    run_step "buffalo-timemachine の LaunchDaemon 確認" check_buffalo_launchdaemon
    run_step "launchd ジョブの死活確認" check_launchd_jobs
    run_step "dotfiles の新着確認" check_dotfiles
    run_step "スナップショットの書き出し" write_snapshot
    run_step "端末間の差分比較" compare_snapshots

    print_summary
    notify

    ((DRY_RUN)) || date '+%Y-%m-%d' >"$LAST_RUN"
    section "daily-sync 終了"
    return 0
}

main "$@"
