#!/usr/bin/env bash
# tree-sitter CLI を node の版解決から切り離すためのラッパー。
#
# なぜ要るか:
#
#   Homebrew の tree-sitter は #!/usr/bin/env node のスクリプトで、起動に
#   node が要る。~/.config/mise/config.toml で
#   idiomatic_version_file_enable_tools に node を入れている (asdf 時代の
#   ~/.asdfrc の legacy_version_file = yes 相当) ので、mise はカレント
#   ディレクトリの .nvmrc / .node-version を拾って版を決める。
#   ところが nvim-treesitter が文法を展開する ~/.cache/nvim/tree-sitter-*/
#   には上流が同梱した .nvmrc が入っていることがあり (2026-08 時点で 10 個中
#   8 個。dart と prisma は中身が "22")、そこに書かれた版が手元に無いと
#   困ったことになる。
#
#   asdf 時代はここで完全一致に失敗して死んでいた:
#
#     No version is set for command node
#     Consider adding one of the following versions in your config file at
#     .../tree-sitter-dart/.tool-versions
#
#   結果 `tree-sitter build` が起動すらできず、:TSUpdate がその言語だけ
#   静かに失敗していた (dart が実際にこうなっていた)。mise は
#   not_found_auto_install が既定で true なので死にはしないが、代わりに
#   パーサのキャッシュディレクトリごとに要らない node を勝手に入れ始める。
#   どちらにせよ避けたいので、グローバルの版で呼び直す。
#
# なぜ .nvmrc を消す・設定側で切るのではないのか:
#
#   .nvmrc はパーサを取り直すたびに上流から復活するので消しても戻る。
#   idiomatic_version_file_enable_tools はよその (仕事の) リポジトリで
#   効かせたい設定なので、グローバルに切ると関係無いところに波及する。
#   ここだけ塞ぐのが一番狭い。
#
# MISE_NODE_VERSION で版が明示されているときは尊重する。

set -euo pipefail

self_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

# PATH を自前で辿る。`command -v` だと自分自身に戻って無限再帰する。
real=""
IFS=: read -ra path_dirs <<<"$PATH"
for dir in "${path_dirs[@]}"; do
    [[ -n "$dir" ]] || continue
    [[ "$(cd -- "$dir" 2>/dev/null && pwd -P)" == "$self_dir" ]] && continue
    if [[ -x "$dir/tree-sitter" && ! -d "$dir/tree-sitter" ]]; then
        real="$dir/tree-sitter"
        break
    fi
done

if [[ -z "$real" ]]; then
    echo "tree-sitter: 本体が PATH に無い (brew install tree-sitter)" >&2
    exit 127
fi

if [[ -n "${MISE_NODE_VERSION:-}" ]]; then
    exec "$real" "$@"
fi

# 空文字を渡すと「有効にするツールは無し」になり、.nvmrc / .node-version が
# 無視されてグローバル (~/.config/mise/config.toml) の node に落ちる。
exec env MISE_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS= "$real" "$@"
