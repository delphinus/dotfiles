#!/bin/bash
# Block commits whose staged diff contains prohibited words.
#
# Backed by gitleaks (https://github.com/gitleaks/gitleaks) using a config
# generated by ansible at ~/.config/gitleaks/dotfiles.toml. The prohibited
# words themselves live in the GIT_PROHIBITED_WORDS env var (secrets.yml, i.e.
# 1Password), never in this repo.
#
# Registered as a config-based hook scoped to this repo; see .gitconfig-hooks.
# Message-only leaks are the commit-msg hook's job; see gitleaks-commit-msg.
#
# Bypass: SKIP_GITLEAKS=1 git commit ...

set -eu

if [ "${SKIP_GITLEAKS:-0}" = "1" ]; then
  exit 0
fi

if ! git remote -v | grep -Eq '^.+\s+(git@github\.com:|https?://github\.com/).+\(push\)$'; then
  exit 0
fi

config="$HOME/.config/gitleaks/dotfiles.toml"
if [ ! -r "$config" ]; then
  echo "gitleaks-pre-commit: $config not found; skipping prohibited words check" >&2
  exit 0
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks-pre-commit: gitleaks not installed; skipping prohibited words check" >&2
  exit 0
fi

exec gitleaks git --pre-commit --staged --no-banner --redact --config "$config"
