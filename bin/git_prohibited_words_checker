#!/bin/bash
# Full-tree scan for prohibited words in ~/git/dotfiles using gitleaks.
# Companion to the pre-commit hook (which only sees staged diffs).
#
# Config:    ~/.config/gitleaks/dotfiles.toml (generated by ansible)
# Source:    ~/git/dotfiles
# Behaviour: working-tree only (--no-git), matching the legacy Perl version.
#            Pass --git to also scan history.

set -eu

scan_mode="dir"
verbose=0
for arg in "$@"; do
  case "$arg" in
    --git) scan_mode="git" ;;
    -v | --verbose) verbose=1 ;;
    -h | --help)
      cat <<USAGE
Usage: $(basename "$0") [--git] [-v|--verbose]

  (default)        scan working tree only
  --git            scan git history as well
  -v, --verbose    show file/commit/line for each finding
USAGE
      exit 0
      ;;
  esac
done

config="$HOME/.config/gitleaks/dotfiles.toml"
source_dir="$HOME/git/dotfiles"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed (try: brew install gitleaks)" >&2
  exit 1
fi
if [ ! -r "$config" ]; then
  echo "config not found: $config (run ansible to regenerate)" >&2
  exit 1
fi
if [ ! -d "$source_dir" ]; then
  echo "source dir not found: $source_dir" >&2
  exit 1
fi

args=(--no-banner --redact --config "$config")
[ "$verbose" -eq 1 ] && args+=(-v)

if [ "$scan_mode" = "git" ]; then
  exec gitleaks git "${args[@]}" "$source_dir"
else
  exec gitleaks dir "${args[@]}" "$source_dir"
fi
