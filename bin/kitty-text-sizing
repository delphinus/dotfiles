#!/bin/sh
# kitty の text sizing protocol (OSC 66) のデモ。kitty 0.40 以降が要る。
# bin/24-bit-color.sh や bin/glyphs と同じく、端末の機能を目で確かめるためのもの。
#
#     OSC 66 ; <metadata> ; <text> BEL
#
# metadata は ':' 区切りの key=value:
#
#     s      全体スケール (1..7)。s*w x s セルのブロックに描く
#     w      幅 (セル数)。0 (既定) なら端末が普通のテキストと同じように分ける
#     n / d  分数スケール (n<d で縮小)。セル数は変えずフォントサイズだけ変える
#     v      分数スケール時の縦位置 (0 上 / 1 下 / 2 中央)
#     h      同じく横位置 (0 左 / 1 右 / 2 中央)
#
# s は基準フォントサイズ (kitty.conf の font_size) の倍数なので、⌘+ で基準を
# 変えれば追従する。非対応の端末は OSC 66 を無視して素のテキストとして出すだけ
# なので、流しても壊れない。
#
# 仕様: https://sw.kovidgoyal.net/kitty/text-sizing-protocol/

t() { printf '\033]66;%s;%s\007' "$1" "$2"; }
nl() { i=0; while [ "$i" -lt "$1" ]; do printf '\n'; i=$((i + 1)); done; }

printf '\n'

# ---- 整数スケール -----------------------------------------------------------
printf '\033[1m== s = 整数スケール ==\033[0m\n\n'
for s in 1 2 3 4 5; do
    printf '  s=%s  ' "$s"
    t "s=$s" 'Kitty 漢字あア'
    nl "$s"
done

# ---- 分数スケール -----------------------------------------------------------
printf '\n\033[1m== n/d = 分数スケール (セル数は変わらない) ==\033[0m\n\n'

printf '  そのまま (n=1:d=2) …… '
t 'n=1:d=2' '半分の大きさの文字'
printf '\n'

# w で「この文字列を何セルに描くか」を宣言すると、字だけでなく占有セルも詰まる。
printf '  w で詰める ……………… '
for pair in '半分' 'の大' 'きさ' 'の文' '字を' '詰め' 'る'; do
    t 'n=1:d=2:w=2' "$pair"
done
printf '\n'

printf '  上付き (n=1:d=2:v=0) … E = mc'
t 'n=1:d=2:w=1' '2'
printf '\n'

printf '  下付き (n=1:d=2:v=1) … H'
t 'n=1:d=2:v=1:w=1' '2'
printf 'O\n'

printf '  中央 (n=1:d=2:v=2) …… '
t 'n=1:d=2:v=2' '縦位置を中央に'
printf '\n'

# ---- 行間を広げる -----------------------------------------------------------
printf '\n\033[1m== s=2:n=1:d=2:v=2 = 等倍の字を 2 行分の高さに置く (行間が広がる) ==\033[0m\n\n'
for line in '一行目 abc' '二行目 def' '三行目 ghi'; do
    printf '  '
    t 's=2:n=1:d=2:v=2' "$line"
    nl 2
done

# ---- 使い道 -----------------------------------------------------------------
printf '\033[1m== 使い道の例 ==\033[0m\n\n'
printf '  '
t 's=2' '見出し / Headline'
nl 2
printf '  本文はふつうの大きさのまま、見出しだけ s=2 にできる。\n\n'
