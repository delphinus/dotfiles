{# GHE のホストは secrets.yml の secret_env が持つ。以前は起動元シェルの環境変数を
   lookup('env', ...) で読んでいたが、素の環境から流すと空になり insteadOf が
   丸ごと欠けた設定が生成される。 -#}
{% set ghe_hosts = secret_env.GITHUB_ENTERPRISE_HOST | default('') -%}
{% if ghe_hosts != '' -%}
{%   for item in ghe_hosts.split(',') -%}
[url "git@{{ item }}:"]
	insteadOf = https://{{ item }}/
[ghq "ssh://git@{{ item }}"]
	vcs = git
{%   endfor -%}
{% endif %}
{% for config in secret_git_configs %}
{% if config.ssh_host is defined %}
[url "git@{{ config.ssh_host }}:{{ config.org }}/"]
	insteadOf = https://github.com/{{ config.org }}/
{% endif %}
[includeIf "gitdir:{{ config.gitdir }}"]
    path = {{ config.filename }}
{% endfor %}
{% if ansible_facts['os_family'] == 'Darwin' -%}
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
  gpgsign = true
{% endif -%}

