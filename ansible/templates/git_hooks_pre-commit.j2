#!/bin/bash
# Transitional shim. The check itself lives in
# ~/git/dotfiles/bin/gitleaks-pre-commit and is registered as a config-based
# hook (`hook.gitleaks-staged.*`) in .gitconfig-hooks, which .gitconfig pulls in
# for this repo only.
#
# Config-based hooks need Git 2.54+. Older Git ignores `hook.*` silently, so
# something has to stay in .git/hooks until every machine is upgraded -- that is
# this file. It feature-tests `git hook list` (2.54+, absent on older Git) and
# stands down when the config hook is registered, so the check never runs twice.
# Configured hooks run first and the hookdir hook runs last, so by the time we
# get here the real check has already had its say.
#
# Delete this template and its ansible task once every machine is on 2.54+.

set -eu

if git hook list pre-commit 2>/dev/null | grep -qx gitleaks-staged; then
  exit 0
fi

exec "$HOME/git/dotfiles/bin/gitleaks-pre-commit" "$@"

#{# vim:se ft=sh.jinja: #}
