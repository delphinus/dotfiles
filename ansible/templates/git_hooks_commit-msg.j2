#!/bin/bash
# Transitional shim. The check itself lives in
# ~/git/dotfiles/bin/gitleaks-commit-msg and is registered as a config-based
# hook (`hook.gitleaks-message.*`) in .gitconfig-hooks, which .gitconfig pulls
# in for this repo only.
#
# See git_hooks_pre-commit.j2 for why this shim exists and when to delete it.

set -eu

if git hook list commit-msg 2>/dev/null | grep -qx gitleaks-message; then
  exit 0
fi

exec "$HOME/git/dotfiles/bin/gitleaks-commit-msg" "$@"

