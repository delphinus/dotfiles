<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.delphinus.daily-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ ansible_facts["env"]["HOME"] }}/git/dotfiles/bin/daily-sync</string>
	</array>
	{#- 在席が見込める時刻に寄せる。sudo や 1Password の対話が要る「要対応」
	    通知に、その場で気付けるようにするため。:00 / :30 を避けて分散させる。

	    2 枠あるのは電源オフ対策。スリープ中に逃した回は復帰時に発火するが、
	    「発火時刻に電源が落ちていた回」は補われず次の枠まで飛ぶ (Apple の
	    Daemons and Services Programming Guide "Effects of Sleeping and
	    Powering Off")。午前を丸ごと落としていても拾えるよう昼前にもう 1 枠
	    置く。当日実行済みなら日付ガード (~/.local/state/daily-sync/last-run)
	    で即抜けるので、2 回目の負荷はほぼ無い。 -#}
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>47</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>11</integer>
			<key>Minute</key>
			<integer>47</integer>
		</dict>
	</array>
	{#- RunAtLoad は付けない。ログインの度に brew upgrade が走ると重い。
	    日付ガード (~/.local/state/daily-sync/last-run) もあるが、そもそも
	    起動契機を増やさない。 -#}
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>{{ ansible_facts["env"]["HOME"] }}</string>
	</dict>
	{#- brew の HEAD ビルド (neovim 等) は数分かかる。フォアグラウンドの作業を
	    邪魔しないよう譲るが、譲り方は Nice と I/O だけに留める。

	    ProcessType = Background は付けない。これは nice 値ではなく darwin
	    background (PRIO_DARWIN_BG) 相当の QoS クランプで、子プロセスまで
	    継承する。Apple Silicon では E コアにしかスケジュールされなくなり、
	    この機体 (M1 Max = P8 + E2) だと neovim の HEAD ビルドが 2400 秒でも
	    終わらなかった (2026-07-31 は 900 秒、2026-08-01 は 2400 秒で打ち切り。
	    どちらも本体の cmake --build 中に kill されている)。前面で流したときは
	    数分で終わるので、遅いのはビルドではなくスケジューリングの側。 -#}
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>{{ ansible_facts["env"]["HOME"] }}/Library/Logs/daily-sync.log</string>
	<key>StandardErrorPath</key>
	<string>{{ ansible_facts["env"]["HOME"] }}/Library/Logs/daily-sync.log</string>
</dict>
</plist>
