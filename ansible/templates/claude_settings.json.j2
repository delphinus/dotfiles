{#- Bartender Pro (Top Shelf) は実 home の絶対パス + シングルクオートでフック導入を検出する。
    一方 base (.claude/settings.json) はこのリポジトリで作業中はプロジェクト設定として直接読まれ、
    /bin/sh で実行されるため "$HOME/..." (ダブルクオート、shell が展開可能) でなければ壊れる。
    そこでレンダリング時のみ "$HOME/...sh" を '<実 home>/...sh' (シングルクオート絶対パス) に変換する。 -#}
{%- set _hook_path = '/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' -%}
{%- set _hook_search = '\\"$HOME' + _hook_path + '\\"' -%}
{%- set _hook_repl = "'" + lookup('env', 'HOME') + _hook_path + "'" -%}
{%- set base = lookup('file', dotfiles_dir + '/.claude/settings.json') | replace(_hook_search, _hook_repl) | from_json -%}
{%- if ansible_facts['hostname'] in secret_office.hostnames -%}
{%- set _ = base.update({'env': secret_claude_code_env}) -%}
{%- set _ = base.update({'enabledPlugins': (base.enabledPlugins | default({})) | combine(secret_claude_code_settings.enabledPlugins | default({}))}) -%}
{%- set _ = base.update({'extraKnownMarketplaces': (base.extraKnownMarketplaces | default({})) | combine(secret_claude_code_settings.extraKnownMarketplaces | default({}))}) -%}
{%- set _secret_perms = secret_claude_code_settings.permissions | default({}) -%}
{%- set _ = base.permissions.update({'allow': (base.permissions.allow | default([])) + (_secret_perms.allow | default([]))}) -%}
{%- set _ = base.permissions.update({'ask': (base.permissions.ask | default([])) + (_secret_perms.ask | default([]))}) -%}
{%- endif -%}
{{ base | to_nice_json(indent=2, sort_keys=False, ensure_ascii=False) }}
