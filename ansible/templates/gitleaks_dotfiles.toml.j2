{# Generated by ansible from GIT_PROHIBITED_WORDS env var. Do not commit. #}
title = "dotfiles prohibited words"

{% for word in lookup('env', 'GIT_PROHIBITED_WORDS').split(',') if word | trim %}
[[rules]]
id          = "prohibited-{{ loop.index }}"
description = "prohibited word"
regex       = '''(?i){{ word | trim }}'''

{% endfor %}
[allowlist]
description = "paths excluded from prohibited word scan"
paths = [
  '''(?:^|/)\.git/''',
  '''(?:^|/)node_modules(?:/|$)''',
  '''(?:^|/)\.mypy_cache(?:/|$)''',
  '''^\.tmux/plugins/''',
  '''^\.tmux/resurrect/''',
  '''^\.zprezto/modules/''',
  '''^\.?vim/dict/''',
  '''^\.?vim/view/''',
  '''^\.zsh/zsh-notify/''',
  '''^submodules/''',
  '''^tampermonkey/''',
  '''\.exe$''',
  '''\.pyc$''',
  '''\.rpm$''',
  '''\.sqlite$''',
  '''^\.config/fish/config-local\.fish$''',
  '''^\.config/fish/functions/tm\.fish$''',
  '''^\.config/nvim/\.netrwhist$''',
  '''^\.config/nvim/lua/_compiled\.lua$''',
  '''^\.screen/(?:cpu|memory)$''',
  '''^ansible/vars/secrets\.yml$''',
  '''^ansible/vars/encrypted\.secrets\.yml$''',
  '''^bin/local_perl\.sh$''',
  '''^bin/macos-askpass$''',
  '''(?:^|/)migemo-dict(?:/|$)''',
]

