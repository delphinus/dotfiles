{#
  Generated by ansible from secrets.yml の secret_env.GIT_PROHIBITED_WORDS.
  Do not commit.

  以前は lookup('env', 'GIT_PROHIBITED_WORDS') で「プレイブックを起動したシェルの
  環境変数」を読んでいた。その値は ~/.envrc (1Password Environments) 由来だったので、
  素の環境から流すと単語が 0 件の設定が生成され、チェックが黙って無効になる。
  secret_env に寄せて、起動元のシェルに依存しないようにしてある。
#}
title = "dotfiles prohibited words"

{% for word in secret_env.GIT_PROHIBITED_WORDS.split(',') if word | trim %}
[[rules]]
id          = "prohibited-{{ loop.index }}"
description = "prohibited word"
regex       = '''(?i){{ word | trim }}'''

{% endfor %}
[allowlist]
description = "paths excluded from prohibited word scan"
paths = [
  '''(?:^|/)\.git/''',
  '''(?:^|/)node_modules(?:/|$)''',
  '''(?:^|/)\.mypy_cache(?:/|$)''',
  '''^\.tmux/plugins/''',
  '''^\.tmux/resurrect/''',
  '''^\.zprezto/modules/''',
  '''^\.?vim/dict/''',
  '''^\.?vim/view/''',
  '''^\.zsh/zsh-notify/''',
  '''^submodules/''',
  '''^tampermonkey/''',
  '''\.exe$''',
  '''\.pyc$''',
  '''\.rpm$''',
  '''\.sqlite$''',
  '''^\.config/fish/functions/tm\.fish$''',
  '''^\.config/nvim/\.netrwhist$''',
  '''^\.config/nvim/lua/_compiled\.lua$''',
  '''^\.screen/(?:cpu|memory)$''',
  '''^ansible/vars/secrets\.yml$''',
  '''^bin/local_perl\.sh$''',
  '''^bin/macos-askpass$''',
  '''(?:^|/)migemo-dict(?:/|$)''',
]

