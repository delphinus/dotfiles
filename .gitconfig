[http]
	sslVerify = true
	cookiefile = ~/.gitcookies
[color]
	ui = true
	status = auto
	diff = auto
	branch = auto
	grep = auto
[color "diff-highlight"]
	oldNormal = red
	oldHighlight = 160 bold white
	newNormal = green
	newHighlight = 65 bold white
[grep]
	lineNumber = true
[alias]
	ad = !git add $@ && git st
	ap = add -p
	br = branch
	ca = commit --amend
	caa = commit --amend --reuse-message HEAD
	cf = clean -df
	cm = commit
	cn = clean -dn
	co = checkout
	cp = cherry-pick
	dc = diff -w --diff-algorithm=default --cached
	dh = diff -w --histogram
	dhc = diff -w --color-words --histogram
	di = diff -w --diff-algorithm=default
	dic = diff -w --color-words --diff-algorithm=default
	dn = diff --name-only
	dp = diff -w --patience
	dpc = diff -w --color-words --patience
	dt = difftool
	ll = log --graph --date-order -C -M --pretty=format:\"<%h> %ad [%an] %Cgreen%d%Creset %s\" --all --date=short
	lo = log --decorate --graph --name-status --oneline
	po = pull origin master
	pu = !git push origin $(git rev-parse --abbrev-ref HEAD)
	pul = !git stash && git pull && git stash pop
	re = remote
	rh = reset --hard
	rl = reflog
	ri = rev-list --pretty --oneline
	rt = revert
	rv = remote -v
	ra = remote-add
	sm = submodule
	st = status -sb
	su = !git br --set-upstream-to=origin/$(git rev-parse --abbrev-ref HEAD)
	sd = !git br --set-upstream-to=delphinus/$(git rev-parse --abbrev-ref HEAD)
	# \x23 means `#`
	ds = !git st --porcelain | grep -v '^[AMD]' | grep -v '^\\x23' | perl -pe 's/^UU\\s+//'
	wk = worktree
	clean-local = !git branch --merged | egrep -v '(^\\*|master|main)' | xargs git branch -d
	show-name = diff-tree --no-commit-id --name-only -r
[url "git@github.com:"]
	pushInsteadOf = "git://github.com/"
	pushInsteadOf = "https://github.com/"
# private なリポジトリを HTTPS で取るときの認証を gh の token に一本化する。
#
# Homebrew の git は自分の etc/gitconfig で credential.helper = osxkeychain を
# 立てるが、keychain の項目 (github.com / delphinus) の ACL が信頼しているのは
# Xcode 付属のヘルパーなので、Homebrew 側のヘルパーから読むと確認ダイアログが
# 出る。無人の launchd (daily-sync) では誰も答えられず、fetch がハングするか
# -128 (userCanceled) で落ちる。2026-09-08 に brew install git を入れて
# Homebrew の git に切り替わったことで顕在化し、private tap (buffalo /
# mycrons / pannonia) の更新が毎日失敗していた。
#
# credential.helper は多値なので、空の値で先に積まれた osxkeychain を捨ててから
# gh のヘルパーだけを積む。PATH を前置するのは、brew の外の素の環境から呼ばれた
# ときに gh を見付けられるようにするため (launchd の PATH には無いことがある)。
[credential "https://github.com"]
	helper =
	helper = !PATH=/opt/homebrew/bin:/usr/local/bin:$PATH gh auth git-credential
[user]
	email = me@delphinus.dev
	name = delphinus
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIACxEJ/p67umFPAPtnLFo4t3aDFfAV5iuOybn3c8Z1dx
[github]
[core]
	excludesfile = ~/git/dotfiles/.gitignore-global
	attributesfile = ~/git/dotfiles/.gitattributes
	autocrlf = false
	quotepath = false
	editor = vim
	pager = delta
[github]
	user = delphinus
[pull]
	rebase = true
[rebase]
	autosquash = true
[tig]
	tab-size = 4
	line-graphics = utf-8
	main-view = line-number:no,interval=5 id:yes date:default author:full commit-title:yes,graph,refs,overflow=no
	main-view-date = custom
	main-view-date-format = %F
	diff-highlight = true
	mouse = true
[tig "bind"]
	generic = G none
	main = R !git rebase -i %(commit)
	main = D !git difftool %(commit)~ %(commit)
	main = Y @sh -c 'printf %s %(commit) | pbcopy'
[tig "color"]
	cursor = white color22 bold
[pager]
	branch = false
[interactive]
	diffFilter = delta --color-only
[ghq]
	root = ~/.local/share/gh/extensions
	root = ~/.local/share/nvim/lazy
	root = ~/.local/share/nvim/site/pack
	root = ~/git
[ghq "ssh://git@git.remora.cx"]
	vcs = git
[ghq "ssh://git@git.delphinus.dev"]
	vcs = git
[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[include]
	path = .gitconfig_local
# 禁止語チェックのフックを dotfiles のクローンにだけ効かせる。remote URL で
# 判定するのは、~/git/dotfiles が symlink で gitdir: が実パスとしか照合せず、
# ふだん使うパスでは一致しないため (2026-09-08 に実測)。private と public の
# 2 本あるのは、どちらか一方しか remote に無い端末でも効かせるため。
[includeIf "hasconfig:remote.*.url:git@github.com:delphinus/dotfiles-private"]
	path = ~/git/dotfiles/.gitconfig-hooks
[includeIf "hasconfig:remote.*.url:git@github.com:delphinus/dotfiles"]
	path = ~/git/dotfiles/.gitconfig-hooks
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true
[diff]
	algorithm = histogram
	renames = true
	indentHeuristic = true
	colorMoved = dimmed_zebra
	#tool = nvimdiff
	tool = nvim_difftool
[difftool "nvr"]
	cmd = nvr -s -d $LOCAL $REMOTE
[difftool "nvimdiff"]
	cmd = nvim -R -d -c 'wincmd l | nnoremap q <Cmd>qa<CR>' -d $LOCAL $REMOTE
[difftool "nvim_difftool"]
	cmd = env DIFFTOOL=1 nvim $LOCAL $REMOTE
[merge]
	ff = false
	tool = nvimdiff
[mergetool "nvr"]
	cmd = nvr -s -d $LOCAL $BASE $REMOTE $MERGED -c 'wincmd J | wincmd ='
[mergetool "nvimdiff"]
	cmd = nvim -d -c '4wincmd w | wincmd J | nnoremap q <Cmd>qa<CR>' $LOCAL $BASE $REMOTE $MERGED
[commit]
	template = ~/git/dotfiles/commit-template.txt
[init]
	defaultBranch = main
[delta]
	features = side-by-side line-numbers decorations
	whitespace-error-style = 22 reverse
	syntax-theme = Nord
[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow ul
	file-decoration-style = none
	line-numbers-left-format = {nm:^4}⡇

# vim:se noet:
